---
import Section from "../components/base/Section.astro";

const stats = [
  {
    label: "LÍNEAS DE BACKEND",
    labelEn: "BACKEND LINES",
    value: "~25K",
    text: "Python en tiempo real · TCP / UDP / HTTPS",
    textEn: "Real-time Python · TCP / UDP / HTTPS",
    color: "text-tertiary",
    hover: "hover:border-tertiary",
    bar: "from-tertiary",
  },
  {
    label: "SUITES DE PRUEBAS",
    labelEn: "TEST SUITES",
    value: "83",
    text: "~32.000 líneas con cliente simulado",
    textEn: "~32,000 lines with a simulated client",
    color: "text-primary",
    hover: "hover:border-primary",
    bar: "from-primary",
  },
  {
    label: "TIEMPO DE CARGA",
    labelEn: "LOAD TIME",
    value: "-90%",
    text: "Motor concurrente de PDFs",
    textEn: "Concurrent PDF engine",
    color: "text-secondary",
    hover: "hover:border-secondary",
    bar: "from-secondary",
  },
  {
    label: "JUGADORES POR PARTIDA",
    labelEn: "PLAYERS PER MATCH",
    value: "60+",
    text: "Más bots, en un servidor propio",
    textEn: "Plus bots, on a custom server",
    color: "text-on-surface",
    hover: "hover:border-tertiary-fixed",
    bar: "from-tertiary-fixed",
  },
];
---

<Section id="about" index="01" tag="PERFIL" tagEn="PROFILE">
  <span
    slot="status"
    class="flex items-center gap-2 rounded-sm bg-surface-container px-3 py-1 text-on-surface-variant"
  >
    <span class="h-2 w-2 rounded-full bg-tertiary"></span>
    <span data-en="COMPUTER SCIENCE // UBA"
      >CIENCIAS DE LA COMPUTACIÓN // UBA</span
    >
  </span>

  <h2
    id="about-title"
    class="max-w-4xl font-display text-headline-lg-mobile font-bold tracking-tight text-on-surface uppercase md:text-headline-lg"
    data-en="From interface to protocol: software that works end to end."
  >
    De la interfaz al protocolo: software que funciona de punta a punta.
  </h2>

  <div class="mt-2 grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
    <div class="flex flex-col gap-4 lg:col-span-7">
      <p
        class="text-body-lg text-on-surface"
        data-en="I'm a full stack developer with experience in web applications (React, Node.js, Astro, Supabase) and real-time backends. I study Computer Science at the University of Buenos Aires, which gives me a solid foundation in algorithms and software architecture."
      >
        Soy desarrollador full stack con experiencia en aplicaciones web (React,
        Node.js, Astro, Supabase) y en backends de tiempo real. Estudio la
        Licenciatura en Ciencias de la Computación en la UBA, lo que me da una
        base sólida en algoritmos y arquitectura de software.
      </p>
      <p
        class="text-body-md text-on-surface-variant"
        data-en="Together with Claude Code (an AI agent) I built the complete backend of a mobile multiplayer game for Android and iOS: binary protocol, cryptography, server-side physics and more than 80 test suites. I use AI agents as a tool: I set the goals, direct the research and test every change."
      >
        Junto a Claude Code (agente de IA) desarrollé el backend completo de un
        juego multijugador móvil para Android e iOS: protocolo binario,
        criptografía, física del lado servidor y más de 80 suites de pruebas.
        Uso los agentes de IA como herramienta: defino los objetivos, dirijo la
        investigación y pruebo cada cambio.
      </p>

      <div
        class="mt-2 flex flex-col gap-2 rounded-lg border border-outline-variant/30 bg-surface-container/60 p-4 backdrop-blur-xl"
      >
        <div
          class="flex flex-wrap items-center justify-between gap-2 font-mono text-label-sm tracking-widest"
        >
          <span class="text-primary" data-en="// LANGUAGES">// IDIOMAS</span>
          <span
            class="rounded-sm bg-surface-container-high px-2 py-0.5 text-tertiary"
            >[ES · PT · EN]</span
          >
        </div>
        <p
          class="text-body-sm text-on-surface-variant"
          data-en="Spanish (native) · Portuguese B2 · English B1 (in progress at UBA)."
        >
          Español nativo · Portugués B2 · Inglés B1 (en curso en la UBA).
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-4 lg:col-span-5">
      {
        stats.map((s) => (
          <li
            class:list={[
              "flex flex-col justify-between rounded-lg border border-outline-variant/30 bg-surface-container/50 p-4 backdrop-blur-xl transition-colors duration-300",
              s.hover,
            ]}
          >
            <span
              class="font-mono text-label-sm tracking-wider text-outline"
              data-en={s.labelEn}
            >
              {s.label}
            </span>
            <div class="my-3">
              <span
                class:list={[
                  "block font-display text-headline-md font-bold",
                  s.color,
                ]}
              >
                {s.value}
              </span>
              <span
                class="font-mono text-label-sm text-on-surface-variant"
                data-en={s.textEn}
              >
                {s.text}
              </span>
            </div>
            <div
              class:list={[
                "h-px w-full bg-gradient-to-r to-transparent",
                s.bar,
              ]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Section>
