---
import AboutFeatureList from "../components/about/AboutFeatureList.astro";

const listItems = [
  {
    title: "Diseño Responsive:",
    text: "Experiencias optimizadas para todos los dispositivos.",
  },
  {
    title: "Rendimiento:",
    text: "Aplicaciones rápidas y eficientes que mejoran la experiencia.",
  },
  {
    title: "Código Limpio:",
    text: "Desarrollo mantenible y escalable usando mejores prácticas.",
  },
  {
    title: "Comunicación Clara:",
    text: "Trabajo colaborativo y transparencia en cada proyecto.",
  },
];
---

<section
  class="overflow-hidden py-14 px-3 bg-gray-50
  dark:bg-gradient-to-br dark:from-indigo-950 dark:via-slate-900 dark:to-indigo-950
  sm:py-16
  md:pt-24 md:px-7 md:pb-0
  lg:py-32 lg:pb-10 lg:px-5"
>
  <div
    class="max-w-[90rem] px-0 mx-auto
    sm:max-w-full sm:px-1
    lg:max-w-5xl
    xl:max-w-6xl xl:px-0
    2xl:max-w-7xl"
  >
    <div
      class="grid grid-cols-1
      md:grid-cols-2 md:gap-x-4 md:items-stretch
      lg:flex lg:gap-0 lg:flex-row lg:mx-auto lg:items-center lg:justify-between"
    >
      <div class="relative">
        <div
          class="text-sm tracking-widest absolute left-[40%] -top-6 rotate-0 hidden lg:inline
            md:-left-16 md:top-16 md:rotate-[-90deg]
            lg:top-0"
        >
          <div
            class="flex
              items-center justify-center gap-2 ocultar-en-tablet"
          >
            <div class="w-10 h-[2px] xl:w-14 bg-indigo-600 dark:bg-indigo-400">
            </div>

            <p class="font-body uppercase dark:text-gray-200">Sobre Mí</p>
          </div>
        </div>

        <h2
          class="mx-auto text-2xl font-bold leading-tight font-heading text-center
          text-gray-900 dark:text-white sm:text-3xl
          md:text-3xl
          xl:mb-4 lg:pl-10 lg:text-left xl:text-4xl xl:ml-6 xl:p-0"
        >
          Creando Experiencias <br /> Digitales Excepcionales
        </h2>

        <div
          class="my-5
          lg:my-10
          xl:max-w-2xl xl:ml-6 xl:my-14 xl:col-start-2"
        >
          <p
            class="text-base font-semibold leading-6 text-indigo-500 text-center
            dark:text-indigo-400 uppercase
            lg:text-left"
          >
            Desarrollo Centrado en el Usuario
          </p>
          <h3
            class="mt-4
            text-2xl font-extrabold leading-8 text-gray-900 font-heading
            dark:text-white ocultar-en-movil
            sm:text-3xl sm:leading-9
            md:mb-6 md:text-xl md:text-gray-700 md:dark:text-gray-200 lg:my-4 xl:text-2xl"
          >
            Soluciones que Marcan la Diferencia
          </h3>

          <AboutFeatureList items={listItems} />
        </div>
      </div>

      <div
        class="mt-5 hidden
        md:flex md:overflow-hidden md:min-h-[28rem] md:relative md:items-end md:justify-center
        lg:mt-0 lg:w-[43%] lg:flex-shrink-0"
      >
        <img
          class="hidden
          md:block md:w-[90%] md:mb-0 md:absolute md:bottom-0 md:left-1/2 md:-translate-x-1/2
          lg:w-[75%]
          xl:w-[70%]"
          src="https://cdn.rareblocks.xyz/collection/celebration/images/team/1/blob-shape.svg"
          alt=""
          loading="lazy"
        />

        <img
          class="w-full relative rounded-full
    md:h-auto md:mb-0 md:absolute md:bottom-0 md:left-1/2 md:-translate-x-1/2
    xl:h-full xl:w-auto xl:mx-auto"
          src="https://res.cloudinary.com/do5ubt5g0/image/upload/v1761519022/Untitled_Project_2_ywtagj.png"
          alt="Elías Martínez, Desarrollador Full-Stack, con pose profesional."
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
