---
import Section from "../components/base/Section.astro";
import Icon from "../components/base/Icon.astro";
import IconSprite from "../components/base/IconSprite.astro";
import CvLink from "../components/base/CvLink.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { contactMethods, socialMedia } from "../data/contactAndSocial.json";

const email = contactMethods.find((m) => m.type === "Email")!;
const phone = contactMethods.find((m) => m.type === "Teléfono")!;
const location = contactMethods.find((m) => m.type === "Ubicación")!;
const socialHovers = [
  "hover:border-primary",
  "hover:border-tertiary",
  "hover:border-secondary",
  "hover:border-tertiary-fixed",
];
---

<Section id="contact" index="05" tag="CONTACTO" tagEn="CONTACT">
  <span slot="status" class="flex items-center gap-2 text-tertiary">
    <span class="h-2 w-2 animate-pulse rounded-full bg-tertiary"></span>
    <span data-en="CHANNEL OPEN">CANAL ABIERTO</span>
  </span>

  <div class="max-w-3xl">
    <h2
      id="contact-title"
      class="bg-gradient-to-r from-tertiary via-primary to-secondary bg-clip-text font-display text-headline-xl-mobile leading-none font-bold tracking-tighter text-transparent uppercase md:text-headline-lg"
      data-en="Initiate transmission."
    >
      Iniciar transmisión.
    </h2>
    <p
      class="mt-3 text-body-lg text-on-surface-variant"
      data-en="Have an open position or want to know more about my experience? Write to me and I'll get back to you shortly, or download my CV."
    >
      ¿Tenés una posición abierta o querés conocer más sobre mi experiencia?
      Escribime y te respondo a la brevedad, o descargá mi CV.
    </p>
  </div>

  <div class="mt-2 grid grid-cols-1 gap-6 lg:grid-cols-12">
    <div class="flex flex-col justify-between gap-4 lg:col-span-5">
      <div class="flex flex-col gap-4">
        <div
          class="flex flex-col gap-1 rounded-lg border border-outline-variant/40 bg-surface-container/60 p-4 backdrop-blur-xl"
        >
          <span
            class="font-mono text-label-sm tracking-wider text-outline"
            data-en="// DIRECT EMAIL">// EMAIL DIRECTO</span
          >
          <div class="mt-1 flex items-center justify-between gap-2">
            <a
              href={email.href}
              id="email-address"
              class="font-mono text-label-md font-semibold tracking-wide break-all text-tertiary hover:underline"
            >
              {email.value}
            </a>
            <button
              type="button"
              id="copy-email-btn"
              class="flex shrink-0 items-center gap-1 rounded-sm bg-surface-container-high px-2.5 py-1 font-mono text-label-sm text-on-surface transition-colors hover:bg-tertiary hover:text-on-tertiary"
            >
              <Icon name="content_copy" size={14} />
              <span data-en="COPY">COPIAR</span>
            </button>
          </div>
        </div>

        <CvLink
          class="group flex items-center justify-between gap-3 rounded-lg border border-tertiary/40 bg-surface-container/60 p-4 backdrop-blur-xl transition-colors hover:border-tertiary hover:shadow-[0_0_24px_-4px_rgba(66,232,255,0.15)]"
        >
          <span class="flex flex-col gap-1">
            <span
              class="font-mono text-label-sm tracking-wider text-outline"
              data-en="// RESUME">// CURRÍCULUM</span
            >
            <span
              class="font-mono text-label-md font-semibold tracking-wide text-on-surface"
              data-en="ELIAS_MARTINEZ_CV.PDF // EN"
              >ELIAS_MARTINEZ_CV.PDF // ES</span
            >
          </span>
          <span
            class="flex shrink-0 items-center gap-1 rounded-sm bg-tertiary px-2.5 py-1 font-mono text-label-sm font-semibold text-on-tertiary"
          >
            <Icon name="download" size={14} />
            <span data-en="DOWNLOAD">DESCARGAR</span>
          </span>
        </CvLink>

        <div class="flex flex-col gap-2">
          <span
            class="font-mono text-label-sm tracking-wider text-outline"
            data-en="// NETWORKS & REPOSITORIES">// REDES & REPOSITORIOS</span
          >
          <ul class="grid grid-cols-2 gap-2 font-mono text-label-sm">
            {
              socialMedia.map((s, i) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      "flex items-center justify-between gap-2 rounded-sm border border-outline-variant/20 bg-surface-container/40 p-3 text-on-surface transition-colors",
                      socialHovers[i % socialHovers.length],
                    ]}
                  >
                    <span class="flex items-center gap-2">
                      <IconSprite
                        id={s.icon}
                        class="h-4 w-4 fill-current text-on-surface-variant"
                      />
                      {s.type.toUpperCase()}
                    </span>
                    <Icon name="open_in_new" size={14} class="text-outline" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="flex flex-col gap-1 rounded-lg border border-outline-variant/20 bg-surface-container/30 p-4 font-mono text-label-sm"
      >
        <span class="text-outline" data-en="LOCATION:">UBICACIÓN:</span>
        <span class="font-semibold text-on-surface uppercase"
          >{location.value}</span
        >
        <a href={phone.href} class="mt-1 text-tertiary hover:underline"
          >TEL // {phone.value}</a
        >
      </div>
    </div>

    <div
      class="rounded-xl border border-outline-variant/40 bg-surface-container/60 p-5 backdrop-blur-2xl md:p-6 lg:col-span-7"
    >
      <ContactForm />
    </div>
  </div>
</Section>

<div
  id="toast"
  role="status"
  class="pointer-events-none fixed right-6 bottom-6 z-50 flex translate-y-20 items-center gap-2 rounded-md border border-tertiary bg-surface-container-highest px-4 py-3 font-mono text-label-sm text-on-surface opacity-0 shadow-[0_0_20px_rgba(39,218,240,0.3)] transition-all duration-300"
>
  <Icon name="check" class="text-tertiary" />
  <span id="toast-message"></span>
</div>

<script>
  const btn = document.getElementById("copy-email-btn")!;
  const email = document.getElementById("email-address")!.textContent!.trim();
  const toast = document.getElementById("toast")!;
  const toastMsg = document.getElementById("toast-message")!;
  let timer: ReturnType<typeof setTimeout>;

  const showToast = (msg: string) => {
    toastMsg.textContent = msg;
    toast.classList.remove("translate-y-20", "opacity-0");
    clearTimeout(timer);
    timer = setTimeout(
      () => toast.classList.add("translate-y-20", "opacity-0"),
      3000,
    );
  };

  btn.addEventListener("click", async () => {
    const en = document.documentElement.lang === "en";
    try {
      await navigator.clipboard.writeText(email);
      showToast(`${en ? "COPIED" : "COPIADO"} // ${email}`);
    } catch {
      showToast(
        en
          ? "COPY FAILED // COPY IT MANUALLY"
          : "NO SE PUDO COPIAR // COPIALO A MANO",
      );
    }
  });
</script>
