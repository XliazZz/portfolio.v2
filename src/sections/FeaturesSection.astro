---
import services from "../data/featuresData.json";
import ServiceGrid from "../components/features/ServiceGrid.astro";

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Servicios de desarrollo web",
  itemListElement: services.map((service, index) => ({
    "@type": "Service",
    position: index + 1,
    name: service.title,
    description: service.text,
    provider: {
      "@type": "Person",
      name: "Elías Martínez",
    },
  })),
};
---

<section
  class="py-14
      bg-white dark:bg-gray-950
      sm:py-16
      lg:py-28
      2xl:pb-52 2xl:pt-36"
  aria-labelledby="services-heading"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(servicesSchema)}
  />
  <div
    class="max-w-4xl
      px-3 mx-auto
      sm:px-6
      lg:max-w-5xl lg:px-5
      xl:max-w-7xl"
  >
    <div class="max-w-3xl
        mx-auto
        text-center lg:mb-2 xl:mb-0">
      <div
        class="flex
          mb-6
          items-center justify-center gap-4"
      >
        <div
          class="w-20 h-[2px]
            bg-gradient-to-r from-transparent to-indigo-600 dark:to-indigo-400"
        >
        </div>
        <span
          class="text-xs font-semibold text-indigo-600 tracking-widest dark:text-indigo-400
            uppercase
            sm:text-sm
            md:text-base"
        >
          Mis Servicios</span
        >
        <div
          class="w-20 h-[2px]
            bg-gradient-to-l from-transparent to-indigo-600 dark:to-indigo-400"
        >
        </div>
      </div>

      <h2
        id="services-heading"
        class="mb-3
            text-[1.5rem] font-bold leading-tight text-gray-900 font-heading dark:text-white
            sm:text-[1.75rem]
            md:text-[2rem]
            lg:text-3xl
            xl:text-4xl"
      >
        Tu Visión, Mi Código,
        <span
          class="text-transparent
            bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400"
        >
          Resultados Excepcionales
        </span>
      </h2>

      <p
        class="max-w-2xl mx-auto mt-3 text-[0.9rem] leading-7
        text-gray-600 font-body dark:text-gray-400
          sm:text-[1rem]
          md:text-[1.05rem]
          lg:text-[1.15rem]
          xl:text-lg 2xl:mt-10 xl:mt-3"
      >
        Creo <strong>servicios de desarrollo web</strong> que combinan
        <strong> diseño excepcional</strong> con
        <strong> tecnología robusta</strong>.
        <span class="hidden lg:block">
          Diseñados específicamente para impulsar el crecimiento de tu negocio.
        </span>
      </p>
    </div>

    <ServiceGrid services={services} />
  </div>
</section>
