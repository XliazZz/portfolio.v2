---
import GradientBackground from "../components/base/GradientBackground.astro";
import Typewriter from "../components/base/Typewriter.astro";
---

<section
  class="flex overflow-hidden
      w-full h-[35vh]
      py-0
      bg-indigo-50
      items-center justify-center relative
      sm:h-[34vh]
      md:h-[30vh]
      lg:h-[99vh]
      2xl:h-[50vh]"
>
  <div class="h-full w-full">
    <GradientBackground />
  </div>

  <div
    class="flex z-10
      max-w-4xl w-full
      mx-auto px-2
      text-center
      absolute inset-0 items-center justify-center
      sm:px-10
      lg:px-0 lg:max-w-3xl
      xl:max-w-6xl"
  >
    <div
      class="w-full
        px-4 py-6
        bg-black/50
        rounded-2xl
        sm:pt-7
        md:h-[83%] md:p-0
        lg:h-[45%] lg:p-0 lg:m-0 lg:py-10
        flex flex-col justify-center
        xl:h-[70%] lg:space-y-7 xl:w-[90%]
        2xl:h-[65%]"
    >
      <p
        class="text-base font-medium leading-8 text-indigo-100 font-heading
          sm:text-xl
          md:text-xl
          lg:text-xl
          xl:text-2xl"
      >
        Hola, soy <span class="font-semibold">Elías Martínez</span>
      </p>

      <div class="flex justify-center items-center w-full">
        <h1
          class="font-heading font-bold text-white w-[250px] xl:w-[350px]
           text-xl sm:text-4xl md:text-4xl xl:text-5xl
           leading-tight tracking-tight
           text-right"
        >
          Programador
          <span class="sr-only">
            {" "}
            web full-stack, frontend y backend developer
          </span>
        </h1>

        <div class="w-3"></div>
        <Typewriter aria-hidden="true" />
      </div>

      <p
        class="max-w-4xl
          sm:mt-2 mx-auto
          leading-relaxed text-slate-300 font-body
          sm:w-[80%] sm:text-lg
          md:w-[90%] md:mt-6
          lg:w-[85%] lg:mt-3 lg:text-base
          xl:text-xl"
      >
        Desarrollo sitios y aplicaciones web rápidas, funcionales y con un
        diseño limpio.
        <br />
        <span class="hidden md:hidden lg:inline">
          {" "}
          Como <span class="font-medium text-white"
            >desarrollador web full-stack</span
          >, trabajo con tecnologías modernas como{" "}
          <span class="font-medium text-white">
            JavaScript, Python, Astro, React y Node.js
          </span>{" "}
          para transformar ideas en productos digitales.
        </span>
      </p>
    </div>
  </div>
</section>
