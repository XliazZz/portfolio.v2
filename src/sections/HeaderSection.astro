---
import Icon from "../components/base/Icon.astro";
import CvLink from "../components/base/CvLink.astro";
import NodeSphere from "../components/base/NodeSphere.astro";
import projects from "../data/projectsCard.json";

const projectCount = String(projects.length).padStart(2, "0");
---

<section
  id="hero"
  class="relative z-10 mx-auto flex w-full max-w-7xl flex-col px-5 pt-24 pb-10 md:px-8 md:pt-28 lg:px-12"
>
  <!-- HUD telemetry bar -->
  <div
    class="flex w-full flex-wrap items-center justify-between gap-2 border-b border-outline-variant/30 pb-4 font-mono text-label-sm text-on-surface-variant"
  >
    <div class="flex flex-wrap items-center gap-4">
      <span
        class="inline-flex items-center gap-1.5 rounded-sm bg-surface-container-high px-2.5 py-1 font-semibold tracking-wider text-tertiary"
      >
        <span class="h-1.5 w-1.5 animate-ping rounded-full bg-tertiary"></span>
        SYS.NODE // BA-AR
      </span>
      <span class="tracking-widest text-outline"
        >STACK: <strong class="font-semibold text-tertiary-fixed"
          >TS · REACT · NODE</strong
        ></span
      >
      <span class="hidden tracking-widest text-outline sm:inline"
        >CORE: <strong class="font-semibold text-primary">UBA // CS</strong
        ></span
      >
    </div>
    <div class="flex items-center gap-4">
      <span class="font-medium tracking-widest text-secondary"
        >[LAT 34.60° S // LON 58.44° W]</span
      >
      <span
        class="hidden items-center rounded-sm bg-surface-container-low px-2.5 py-1 font-semibold tracking-wider text-tertiary-fixed md:inline-flex"
        data-en="OPEN TO NEW ROLES">DISPONIBLE PARA NUEVOS ROLES</span
      >
    </div>
  </div>

  <div
    class="grid grid-cols-1 items-center gap-10 pt-12 pb-10 lg:grid-cols-12 lg:gap-6"
  >
    <div class="flex flex-col gap-4 lg:col-span-8">
      <div class="inline-flex items-center gap-2">
        <span class="h-px w-6 bg-tertiary"></span>
        <span
          class="font-mono text-label-md uppercase tracking-widest text-tertiary"
          >// SOFTWARE ENGINEER · FULL STACK</span
        >
      </div>

      <h1
        class="font-display text-headline-xl-mobile leading-none font-bold tracking-tighter uppercase sm:text-headline-lg xl:text-headline-xl"
      >
        <span class="block text-on-surface">Elías Martínez</span>
        <span
          class="mt-1 block bg-gradient-to-r from-tertiary via-primary to-secondary bg-clip-text text-transparent"
          >Full Stack // Dev</span
        >
      </h1>

      <p
        class="mt-1 max-w-2xl text-body-lg font-light text-on-surface-variant"
        data-en="I build web applications and real-time backends: from React and Astro interfaces to servers with binary protocols, cryptography and server-side physics. Computer Science student at the University of Buenos Aires."
      >
        Desarrollo aplicaciones web y backends de tiempo real: desde interfaces
        en React y Astro hasta servidores con protocolos binarios, criptografía
        y física del lado servidor. Estudio Ciencias de la Computación en la
        UBA.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="#projects"
          class="group inline-flex items-center gap-3 rounded-sm bg-tertiary px-6 py-2.5 font-mono text-label-md font-semibold tracking-wider text-on-tertiary shadow-[0_0_25px_rgba(39,218,240,0.3)] transition-all duration-300 hover:bg-tertiary-fixed"
        >
          <span
            class="h-2 w-2 rounded-full bg-on-tertiary transition-transform group-hover:scale-125"
          ></span>
          <span data-en={`VIEW PROJECTS [${projectCount}]`}
            >VER PROYECTOS [{projectCount}]</span
          >
          <Icon
            name="arrow_forward"
            class="transition-transform group-hover:translate-x-1"
          />
        </a>
        <CvLink
          class="inline-flex items-center gap-2 rounded-sm border border-outline-variant/40 bg-surface-container/70 px-6 py-2.5 font-mono text-label-md font-medium tracking-wider text-on-surface backdrop-blur-xl transition-all duration-300 hover:border-primary hover:text-primary hover:shadow-[0_0_25px_rgba(208,188,255,0.2)]"
        >
          <Icon name="download" size={16} class="text-primary" />
          <span data-en="DOWNLOAD CV">DESCARGAR CV</span>
        </CvLink>
      </div>
    </div>

    <!-- Decorative and pointer-only, so it is hidden from assistive tech. -->
    <div
      class="relative flex flex-col items-center justify-center gap-2 lg:col-span-4"
      aria-hidden="true"
    >
      <div
        class="pointer-events-none absolute top-1/2 left-1/2 h-48 w-48 -translate-x-1/2 -translate-y-1/2 animate-pulse rounded-full bg-tertiary/10 blur-3xl"
      >
      </div>
      <NodeSphere class="relative h-80 w-80 md:h-96 md:w-96" />
      <div
        class="flex flex-col items-center gap-1.5 font-mono text-label-sm tracking-widest"
      >
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
          <span class="flex items-center gap-1.5 text-tertiary"
            ><span class="h-1.5 w-1.5 rounded-full bg-tertiary"
            ></span>FRONTEND</span
          >
          <span class="flex items-center gap-1.5 text-primary"
            ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span><span
              data-en="BACKEND & DATA">BACKEND & DATOS</span
            ></span
          >
          <span class="flex items-center gap-1.5 text-secondary"
            ><span class="h-1.5 w-1.5 rounded-full bg-secondary"></span><span
              data-en="SYSTEMS & AI">SISTEMAS & IA</span
            ></span
          >
        </div>
        <span class="text-outline" data-en="// DRAG TO ROTATE"
          >// ARRASTRÁ PARA ROTAR</span
        >
      </div>
    </div>
  </div>

  <div
    class="flex w-full items-center justify-between border-t border-outline-variant/20 pt-8 text-on-surface-variant"
  >
    <div class="flex items-center gap-3">
      <div
        class="h-6 w-1.5 animate-pulse rounded-sm bg-gradient-to-b from-tertiary to-transparent"
      >
      </div>
      <span
        class="font-mono text-label-sm tracking-widest text-outline"
        data-en="SCROLL TO EXPLORE">DESPLAZÁ PARA EXPLORAR</span
      >
    </div>
    <span class="font-mono text-label-sm tracking-widest text-outline"
      >INDEX // 001 - 005</span
    >
  </div>
</section>
