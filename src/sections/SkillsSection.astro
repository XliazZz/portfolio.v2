---
import Section from "../components/base/Section.astro";
import Icon from "../components/base/Icon.astro";
import IconSprite from "../components/base/IconSprite.astro";
import { skills, techs } from "../data/stackData.ts";

const stack = [...skills, ...techs];

const clusters = [
  {
    icon: "layers",
    title: "Frontend",
    titleEn: "Frontend",
    accent: "text-tertiary",
    hover: "hover:border-tertiary/60",
    items: [
      { name: "React · Redux", tag: "SPA / ESTADO", tagEn: "SPA / STATE" },
      { name: "Astro · Next.js · Vite", tag: "SSR / SSG", tagEn: "SSR / SSG" },
      { name: "TypeScript · JavaScript", tag: "LENGUAJES", tagEn: "LANGUAGES" },
      { name: "Tailwind · CSS3 · Bootstrap", tag: "ESTILOS", tagEn: "STYLING" },
    ],
  },
  {
    icon: "database",
    title: "Backend & Datos",
    titleEn: "Backend & Data",
    accent: "text-primary",
    hover: "hover:border-primary/60",
    items: [
      { name: "Node.js · Express", tag: "API REST", tagEn: "REST API" },
      { name: "Python · Django · Java", tag: "BACKEND", tagEn: "BACKEND" },
      {
        name: "PostgreSQL · MongoDB · SQLite",
        tag: "BASES DE DATOS",
        tagEn: "DATABASES",
      },
      { name: "Supabase · Cloudinary", tag: "CLOUD", tagEn: "CLOUD" },
      { name: "JWT · OAuth", tag: "AUTH", tagEn: "AUTH" },
    ],
  },
  {
    icon: "token",
    title: "Sistemas, Seguridad & IA",
    titleEn: "Systems, Security & AI",
    accent: "text-secondary",
    hover: "hover:border-secondary/60",
    items: [
      { name: "Sockets TCP / UDP", tag: "TIEMPO REAL", tagEn: "REAL-TIME" },
      {
        name: "RSA · TLS · DNS over HTTPS",
        tag: "SEGURIDAD",
        tagEn: "SECURITY",
      },
      {
        name: "Protocolos binarios",
        nameEn: "Binary protocols",
        tag: "ING. INVERSA",
        tagEn: "REVERSE ENG.",
      },
      { name: "Claude Code · Gemini", tag: "AGENTES IA", tagEn: "AI AGENTS" },
      {
        name: "Testing · Git · Linux · Scrum",
        tag: "PRÁCTICAS",
        tagEn: "PRACTICES",
      },
    ],
  },
];
---

<Section id="stack" index="02" tag="STACK TECNOLÓGICO" tagEn="TECH STACK">
  <Fragment slot="status">
    <span data-en="DIAGNOSTIC:">DIAGNÓSTICO:</span>
    <span class="font-semibold text-tertiary" data-en="ALL NODES ONLINE"
      >TODOS LOS NODOS ONLINE</span
    >
  </Fragment>

  <div class="flex flex-col gap-2">
    <h2
      id="stack-title"
      class="font-display text-headline-md-mobile font-bold tracking-tight text-on-surface uppercase md:text-headline-md"
      data-en="Stack & protocols"
    >
      Stack & protocolos
    </h2>
    <p
      class="max-w-2xl text-body-md text-on-surface-variant"
      data-en="The tools I build with, from the browser down to the socket."
    >
      Las herramientas con las que construyo, del navegador hasta el socket.
    </p>
  </div>

  <!-- Infinite tech streamer: the list is rendered twice so the -50% loop is seamless -->
  <div
    class="group flex w-full overflow-hidden rounded-sm border-y border-outline-variant/20 bg-surface-container-lowest/80 py-3 select-none"
  >
    {
      [false, true].map((duplicate) => (
        <ul
          class="flex shrink-0 animate-marquee items-center gap-8 pr-8 whitespace-nowrap group-hover:[animation-play-state:paused]"
          aria-hidden={duplicate ? "true" : undefined}
        >
          {stack.map((item, i) => (
            <li
              class:list={[
                "flex items-center gap-2 font-mono text-label-md",
                [
                  "text-tertiary",
                  "text-on-surface-variant",
                  "text-primary",
                  "text-on-surface-variant",
                  "text-secondary",
                ][i % 5],
              ]}
            >
              <IconSprite id={item.icon} class="h-4 w-4 fill-current" />
              {item.title}
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      clusters.map((c, i) => (
        <article
          class:list={[
            "flex flex-col gap-4 rounded-xl border border-outline-variant/30 bg-surface-container/60 p-6 backdrop-blur-xl transition-colors duration-300",
            c.hover,
          ]}
        >
          <div class="flex items-center justify-between border-b border-outline-variant/20 pb-2">
            <div class="flex items-center gap-2">
              <Icon name={c.icon} size={20} class={c.accent} />
              <span class="font-mono text-label-md font-semibold tracking-wider text-on-surface">
                CLUSTER 0{i + 1}
              </span>
            </div>
            <span
              class:list={[
                "rounded-sm bg-surface-container-high px-2 py-0.5 font-mono text-label-sm",
                c.accent,
              ]}
            >
              [ACTIVE]
            </span>
          </div>
          <h3
            class="font-display text-headline-sm text-on-surface"
            data-en={c.titleEn}
          >
            {c.title}
          </h3>
          <ul class="flex flex-col">
            {c.items.map((item) => (
              <li class="flex items-center justify-between gap-3 border-b border-white/5 py-2.5 transition-colors last:border-0 hover:bg-gradient-to-r hover:from-primary-container/10 hover:to-transparent">
                <span
                  class="text-body-sm text-on-surface"
                  data-en={item.nameEn}
                >
                  {item.name}
                </span>
                <span
                  class:list={[
                    "shrink-0 font-mono text-label-sm tracking-widest",
                    c.accent,
                  ]}
                  data-en={item.tagEn}
                >
                  {item.tag}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
