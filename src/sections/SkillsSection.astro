---
import TechStackMarquee from "../components/skills/TechStackMarquee.astro";
import { skills, techs } from "../data/stackData.ts";
---

<section
  class="py-14
  bg-gray-50 dark:bg-gradient-to-bl dark:from-indigo-950 dark:via-slate-900 dark:to-indigo-950
  sm:py-18
  lg:py-10"
>
  <div
    class="container
      max-w-4xl
      mx-auto
      lg:max-w-5xl
      xl:max-w-6xl
      2xl:max-w-7xl"
  >
    <div class="flex flex-col
        justify-center items-center">
      <p
        class="mb-3
          text-sm tracking-widest text-indigo-600 font-body
          uppercase dark:text-indigo-300
          xl:text-sm"
      >
        Mi ecosistema de desarrollo
      </p>

      <h2
        class="block
          mb-2
          text-2xl font-extrabold text-gray-700 font-heading
          dark:text-white
          sm:mb-4
          md:text-3xl
          xl:text-4xl"
      >
        Stack tecnológico
      </h2>
      <p
        class="w-[80%]
          text-gray-600 text-sm font-body text-center italic
          dark:text-slate-400
          sm:text-md
          md:text-lg
          lg:w-full lg:text-base
          xl:text-lg"
      >
        Tecnologías que uso como <strong>desarrollador full-stack</strong> para crear
        sitios web rápidos y modernos.
      </p>
    </div>

    <div
      class="overflow-hidden
        w-full
        space-y-8 mt-10
        relative
        sm:mt-12
        lg:mt-12"
    >
      <TechStackMarquee data={skills} trackClass="marquee-track" />

      <TechStackMarquee data={techs} trackClass="marquee-track-reverse" />
    </div>
  </div>
</section>
