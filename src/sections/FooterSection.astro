---
import CvLink from "../components/base/CvLink.astro";
import { socialMedia } from "../data/contactAndSocial.json";

const currentYear = new Date().getFullYear();
---

<!-- In the reference the shader's dark bottom edge covers the footer at 40%: #0e0e12 becomes #08080b.
     We keep the footer above the canvas (legible text) and bake that tone in instead. -->
<footer
  class="relative z-10 w-full bg-[#08080b] py-10"
  aria-label="Pie de página"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-5 md:px-8">
    <div
      class="flex flex-col justify-between gap-4 md:flex-row md:items-center"
    >
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 animate-pulse rounded-full bg-tertiary"></span>
        <span
          class="font-mono text-label-sm font-semibold tracking-wider text-tertiary"
          data-en="STATUS: OPEN TO NEW ROLES"
          >STATUS: DISPONIBLE PARA NUEVOS ROLES</span
        >
      </div>
      <div
        class="flex flex-wrap items-center gap-4 font-mono text-label-sm text-on-surface-variant"
      >
        <span>BUENOS AIRES // UTC-3</span>
        <span
          ><time id="local-time">--:--</time> // <span data-en="LOCAL TIME"
            >HORA LOCAL</span
          ></span
        >
      </div>
    </div>
    <div
      class="flex flex-col justify-between gap-4 border-t border-white/5 pt-4 md:flex-row md:items-center"
    >
      <span class="font-mono text-label-sm tracking-wider text-outline">
        © {currentYear} ELÍAS MARTÍNEZ. <span
          data-en="BUILT WITH ASTRO + TAILWIND."
          >HECHO CON ASTRO + TAILWIND.</span
        >
      </span>
      <ul
        class="flex flex-wrap items-center gap-4 font-mono text-label-sm text-on-surface-variant"
      >
        {
          socialMedia.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-tertiary"
              >
                {s.type.toUpperCase()}
              </a>
            </li>
          ))
        }
        <li>
          <CvLink
            class="text-tertiary transition-colors hover:text-tertiary-fixed"
            >CV.PDF</CvLink
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const clock = document.getElementById("local-time")!;
  const format = new Intl.DateTimeFormat("es-AR", {
    timeZone: "America/Argentina/Buenos_Aires",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
  const tick = () => (clock.textContent = format.format(new Date()));
  tick();
  setInterval(tick, 30_000);
</script>
