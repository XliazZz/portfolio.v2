---
import Button from "../components/base/Button.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="overflow-hidden pt-32 pb-16 w-full text-black bg-gradient-to-tr from-white to-indigo-50 relative lg:pt-56 lg:pb-28 dark:from-gray-950 dark:to-gray-900"
  aria-label="Pie de página del portfolio de Elias Martinez"
>
  <div
    class="overflow-hidden
    w-full h-full
    opacity-20
    absolute top-0 left-0
    pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="w-20 h-20
        bg-indigo-500/80
        rounded-full
        absolute top-10 left-4 filter blur-2xl
        md:w-32 md:h-32 md:top-20 md:left-10 md:blur-3xl"
    >
    </div>
    <div
      class="w-24 h-24
        bg-purple-500/80
        rounded-full
        absolute top-20 right-4 filter blur-2xl
        md:w-40 md:h-40 md:top-40 md:right-20 md:blur-3xl"
    >
    </div>
    <div
      class="w-28 h-28
        bg-purple-800/80
        rounded-full
        absolute bottom-4 left-1/2 -translate-x-1/2 filter blur-2xl
        md:w-48 md:h-48 md:bottom-10 md:blur-3xl"
    >
    </div>
  </div>

  <div
    class="max-w-4xl
      mx-auto px-4
      relative
      sm:px-6 lg:max-w-5xl lg:px-5
      xl:max-w-6xl xl:px-0
      2xl:max-w-7xl"
  >
    <div
      class="flex flex-col
        pb-8 mb-6 space-y-8
        border-b border-indigo-300/30
        justify-between items-center
        md:pb-12 md:mb-0
        lg:flex-row md:space-y-10 lg:space-y-0"
    >
      <div
        class="flex flex-col
          text-center
          items-center
          lg:text-left lg:items-start"
      >
        <div
          class="flex
            space-x-2 mb-3
            items-center
            lg:space-x-3 md:mb-4"
        >
          <div
            class="flex
              w-8 h-8
              bg-white dark:bg-indigo-950
              border border-indigo-500 rounded-lg
              items-center justify-center
              md:w-10 md:h-10"
          >
            <span
              class="text-lg font-bold text-indigo-500 font-heading md:text-xl"
              aria-hidden="true"
            >
              EM
            </span>
          </div>
          <span
            class="text-xl font-bold text-black dark:text-white tracking-tight font-heading
              md:text-2xl"
          >
            Elias Martinez
          </span>
        </div>
        <p
          class="text-xs text-gray-500 dark:text-gray-300 font-body md:text-sm"
        >
          Diseñador UX/UI y desarrollador web full-stack
        </p>
      </div>

      <div class="order-first
          text-center
          md:order-none">
        <a
          href="https://wa.me/5491135726318?text=Hola!%20Quiero%20info%20sobre%20mi%20página%20web"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Iniciar conversación por WhatsApp (abrirá en nueva pestaña)"
          class="inline-block
            text-4xl font-bold text-black dark:text-white tracking-tight font-heading
            transition-all
            hover:scale-105 hover:text-indigo-500 duration-300 group
            md:text-5xl"
        >
          <span
            class="text-indigo-600 font-heading
              transition-colors
            group-hover:text-black dark:group-hover:text-white dark:hover:text-white duration-300"
            >Di</span
          >
          <span
            class="transition-all
      group-hover:drop-shadow-[0_0_15px_rgba(165,180,252,0.6)] duration-300"
            >Hola.</span
          >
        </a>
        <p
          class="mt-1
            text-gray-500 dark:text-gray-300 text-sm font-body
            transition-colors
            group-hover:text-gray-300 duration-300
            md:mt-2 md:text-md"
        >
          Conversemos sobre tu próximo proyecto
        </p>
      </div>

      <div class="text-center
          md:text-right">
        <Button
          href="#projects"
          variant="rounded"
          ariaLabel="Ver Portafolio"
          class="text-indigo-600 border bg-transparent border-indigo-600 rounded-full transition-all items-center hover:bg-indigo-600 hover:text-white"
        >
          <span class="font-heading"> Ver Portafolio → </span>
        </Button>
      </div>
    </div>

    <div
      class="w-full
        pt-4 mx-auto
        text-center text-xs font-body
        items-center
        md:pt-6 md:text-sm"
    >
      <p class="w-full
    mb-3 mx-auto
    text-gray-500
    md:mb-0">
        &copy; {currentYear} Elias Martinez. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
