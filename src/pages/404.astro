---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/base/Icon.astro";

const pageTitle = "Página no encontrada | Elías Martínez";
const pageDescription =
  "La página que estás buscando no existe o fue movida. Volvé al inicio para ver mi experiencia, proyectos y CV.";
const ogImage = new URL("/og-image.jpg", Astro.site).href;

const authorData = {
  name: "Elías Martínez",
  url: "https://portfolio-v2-rust-kappa.vercel.app/",
  socialProfiles: {
    linkedin: "https://www.linkedin.com/in/eliasm166/",
    github: "https://github.com/XliazZz",
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  authorName={authorData.name}
  authorUrl={authorData.url}
  socialProfiles={authorData.socialProfiles}
>
  <main
    id="main-content"
    class="relative z-10 mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 px-5 text-center"
  >
    <p class="font-mono text-label-md tracking-widest text-secondary">
      <span class="text-tertiary">$</span> ERROR // HTTP 404
    </p>
    <p
      class="bg-gradient-to-r from-tertiary via-primary to-secondary bg-clip-text font-display text-[120px] leading-none font-bold tracking-tighter text-transparent md:text-[180px]"
      aria-hidden="true"
    >
      404
    </p>
    <h1
      class="font-display text-headline-md-mobile font-bold text-on-surface uppercase md:text-headline-md"
      data-en="Route not found"
    >
      La ruta no existe
    </h1>
    <p
      class="max-w-md text-body-lg text-on-surface-variant"
      data-en="The resource you tried to reach was removed, renamed or never existed."
    >
      El recurso al que intentaste acceder fue removido, renombrado o nunca
      existió.
    </p>
    <a
      href="/"
      class="mt-4 inline-flex items-center gap-2 rounded-sm bg-tertiary px-6 py-2.5 font-mono text-label-md font-semibold tracking-wider text-on-tertiary shadow-[0_0_25px_rgba(39,218,240,0.3)] transition-colors hover:bg-tertiary-fixed"
    >
      <Icon name="arrow_back" />
      <span data-en="BACK HOME">VOLVER AL INICIO</span>
    </a>
  </main>
</Layout>
