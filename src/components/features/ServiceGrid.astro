---
interface Service {
  id: string;
  title: string;
  text: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<ul
  class="grid grid-cols-2
    mt-8 px-2
    text-center
    gap-x-5 gap-y-8
    sm:grid-cols-2 sm:mt-10 sm:gap-x-0
    md:grid-cols-3 md:gap-0
    lg:grid-cols-4 lg:px-0 lg:gap-x-0 lg:gap-y-2 lg:gap-5
    xl:gap-y-6 xl:gap-x-0 2xl:mt-18
    2xl:px-0 2xl:gap-y-20"
>
  {
    services.map((service, index) => (
      <a
        href="#contact"
        class="block md:py-4 transition duration-300 ease-in-out hover:bg-gray-50 hover:shadow-lg rounded-lg p-4"
        aria-labelledby={`service-${index}-title`}
      >
        <li class="md:py-4" aria-labelledby={`service-${index}-title`}>
          <svg
            class="w-8 h-8 mx-auto text-indigo-600 lg:w-10 lg:h-10"
            viewBox="0 0 46 46"
            fill="none"
            aria-hidden="true"
          >
            <use href={`/featuresSprite.svg#${service.id}`} />
          </svg>

          <h3
            id={`service-${index}-title`}
            class="mt-2
            text-[0.95rem] text-gray-900 font-heading
            sm:text-[1rem]
            md:text-[1.05rem]
            xl:mt-6 lg:mt-4 lg:text-base lg:font-bold
            xl:text-xl"
          >
            {service.title}
          </h3>

          <p
            class="w-[80%]
            mt-1 px-0 mx-auto
            text-[0.8rem] text-gray-600 font-body text-center
            ocultar-en-movil
            sm:text-[0.85rem]
            md:text-[0.9rem]
            xl:mt-2 lg:mt-3 lg:text-sm lg:px-0
            xl:text-base xl:w-[60%]"
          >
            {service.text}
          </p>
        </li>
      </a>
    ))
  }
</ul>
