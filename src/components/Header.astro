---
import GradientBackground from "./ui/GradientBackground.astro";
---

<section
  class="flex overflow-hidden
      w-full h-[32vh]
      py-0
      bg-indigo-50
      items-center justify-center relative
      sm:h-[34vh]
      md:h-[30vh]
      lg:h-[40vh]
      xl:h-[45vh]
      2xl:h-[40vh]"
>
  <div class="h-full w-full">
    <GradientBackground client:load />
  </div>

  <div
    class="flex z-10
      max-w-4xl w-full
      mx-auto px-5
      text-center
      absolute inset-0 items-center justify-center
      sm:px-10
      lg:px-0 lg:max-w-3xl
      xl:max-w-6xl"
  >
    <div
      class="w-full
        px-4 py-6
        bg-black/50
        rounded-2xl
        sm:pt-7
        md:h-[83%] md:p-0
        lg:h-[55%] lg:p-0 lg:m-0 lg:py-10
         flex flex-col justify-center
         xl:h-[70%] xl:space-y-7 xl:w-[90%]
         2xl:h-[60%]"
    >
      <p
        class="text-lg font-medium leading-8 text-indigo-100 font-heading
          sm:text-xl
          md:text-xl
          lg:text-lg
          xl:text-xl"
      >
        Hola, soy <span class="font-semibold">Elías Martínez</span>
      </p>

      <div
        class="flex
          min-h-[60px] w-full
          justify-center items-center
        xl:min-h-auto xl:mb-2"
      >
        <h1
          class="overflow-hidden
            w-[23rem]
            font-bold font-heading leading-[4rem] tracking-tight text-white text-[1.8rem] text-left
            sm:w-[28rem] sm:text-[2.3rem]
            md:w-[25rem] md:text-[2rem]
            lg:w-[32rem] lg:text-[2.5rem]
            xl:text-4xl xl:h-[5rem] xl:w-[46rem] xl:my-auto xl:py-auto"
        >
          <span class="whitespace-nowrap">Programador</span>

          <span
            id="typewriter"
            class="inline-block
                ml-2
                align-top text-transparent
                bg-gradient-to-r from-indigo-500 to-pink-400 bg-clip-text
                relative
                lg:ml-1"
          >
            <span class="text"></span>
            <span class="cursor"></span>
          </span>
        </h1>
      </div>

      <p
        class="max-w-4xl
          mt-2 mx-auto
          leading-relaxed text-slate-300 font-body
          sm:w-[80%] sm:text-lg
          md:w-[90%] md:mt-6
          lg:w-[80%] lg:mt-3 lg:text-base
          xl:text-lg"
      >
        Desarrollo sitios y aplicaciones web rápidas, funcionales y con un
        diseño limpio.

        <span class="ocultar-en-movil">
          Trabajo con tecnologías modernas como
          <span class="font-medium text-white">
            JavaScript, Python, Astro, React y Node.js
          </span>
          para transformar ideas en productos digitales.
        </span>
      </p>
    </div>
  </div>
</section>

<script>
  import { typewriterEffect } from "../scripts/typewriter";
  document.addEventListener("DOMContentLoaded", typewriterEffect);
</script>

<style>
  #typewriter {
    position: relative;
    display: inline-block;
  }

  #typewriter .text {
    display: inline-block;
  }

  #typewriter .cursor {
    position: absolute;
    top: 0;
    width: 2px;
    background-color: #ffffff;
    animation: blink-caret 0.8s step-end infinite;

    height: 100%;
  }

  @media (max-width: 768px) {
    #typewriter .cursor {
      height: 70%;
      top: 15%;
    }

    .ocultar-en-movil {
      display: none;
    }
  }

  @media (max-width: 480px) {
    #typewriter .cursor {
      height: 60%;
      top: 20%;
    }
  }

  @keyframes blink-caret {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
</style>
