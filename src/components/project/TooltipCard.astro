---
interface Props {
  tech: {
    name: string;
    icon: string;
  };
}

const { tech } = Astro.props;
---

<span class="inline-block w-3 h-3 mr-2 align-middle">
  <svg viewBox="0 0 128 128" fill="currentColor">
    <use href={`/techsSprite.svg#${tech.icon}`}></use>
  </svg>
</span>
<span class="align-middle">{tech.name}</span>

<style></style>
