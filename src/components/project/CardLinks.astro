---
import Button from "../ui/Button.astro";

interface Props {
  demoUrl?: string;
  githubUrl?: string;
}

const { demoUrl, githubUrl } = Astro.props;
---

<div
  class="flex
      w-full
      px-4 pb-4
      font-heading text-sm
      rounded gap-3 uppercase"
>
  {
    demoUrl && (
      <Button
        text="Ver Demo"
        icon="external-link"
        href={demoUrl}
        classStyle="text-white bg-indigo-600 border hover:bg-indigo-700"
      />
    )
  }
  {
    githubUrl && (
      <Button
        text="Código"
        icon="fa:github"
        href={githubUrl}
        classStyle="text-indigo-600 border border-indigo-600 hover:bg-indigo-50 bg-white ocultar-en-movil"
      />
    )
  }
</div>

<style>
  @media (max-width: 768px) {
    .ocultar-en-movil {
      display: none;
    }
  }
</style>
