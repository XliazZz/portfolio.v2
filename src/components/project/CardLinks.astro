---
interface Props {
  demoUrl?: string;
  githubUrl?: string;
}

const { demoUrl, githubUrl } = Astro.props;
---
  <div
    class="
      flex
      w-full
      px-4 pb-4
      font-heading text-sm
      rounded gap-3 uppercase
    "
  >
    {
      demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
            class="
              inline-flex flex-1
              px-4 py-2.5
              align-middle font-semibold text-center text-white
              bg-indigo-600
              border rounded-lg
              select-none transition-colors shadow-sm
              items-center justify-center duration-200 ease-in hover:bg-indigo-700 hover:shadow-md
            "
          
        >
          <svg
            class="
              w-4 h-4
              mr-2
            "
          
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <use href={`/techsSprite.svg#external-link`} />
          </svg>
          Ver Demo
        </a>
      )
    }
    {
      githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
            class="
              inline-flex flex-1
              px-4 py-2.5
              align-middle font-semibold text-center text-indigo-600
              border border-indigo-600 rounded-lg
              select-none transition-colors shadow-sm
              items-center justify-center duration-200 ease-in hover:bg-indigo-50 hover:shadow-md hover:border-indigo-700
            "
          
        >
          <svg
            class="
              w-4 h-4
              mr-2
            "
           fill="currentColor" viewBox="0 0 24 24">
            <use href={`/techsSprite.svg#fa:github`} />
          </svg>
          Código
        </a>
      )
    }
  </div>

<style>

</style>