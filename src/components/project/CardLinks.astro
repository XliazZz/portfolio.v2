---
import Button from "../ui/Button.astro";

interface Props {
  demoUrl?: string;
  githubUrl?: string;
}

const { demoUrl, githubUrl } = Astro.props;
---

<div
  class="flex
      w-full px-1
      font-heading text-sm
      rounded gap-3 uppercase lg:px-0 lg:py-0"
>
  {
    demoUrl && (
      <Button
        text="Ver Demo"
        icon="external-link"
        href={demoUrl}
        classStyle="py-0 sm:text-base text-xs text-white bg-indigo-600 border hover:bg-indigo-700 xl:py-3.5"
      />
    )
  }
  {
    githubUrl && (
      <Button
        text="Código"
        icon="fa:github"
        href={githubUrl}
        classStyle="py-0 sm:text-base text-xs text-white bg-indigo-600 border hover:bg-indigo-700 ocultar-en-movil xl:py-3.5"
      />
    )
  }
</div>

<style>
  @media (max-width: 767px) {
    .ocultar-en-movil {
      display: none;
    }
  }
</style>
