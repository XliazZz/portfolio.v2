---
import Tooltip from "../../base/Tooltip.astro";

interface Props {
  technologies: Array<{ name: string; icon: string }>;
  remainingCount: number;
}
const { technologies, remainingCount } = Astro.props;
---

<div class="relative group/tooltip">
  <button
    class="w-8 h-8
      text-gray-500 font-medium
      bg-gray-100
      rounded-lg border border-gray-200
      transition-all
      hover:text-indigo-600 hover:bg-indigo-100 hover:border-indigo-200 duration-200
      md:w-9 md:h-9"
    data-shape="circular"
    aria-label={`Mostrar ${remainingCount} tecnologías adicionales`}
    aria-expanded="false"
  >
    +{remainingCount}
  </button>

  <div
    class="z-10
      mb-2 px-3 py-2
      text-white text-xs whitespace-nowrap
      bg-gray-900
      rounded-lg
      opacity-0 transition-opacity pointer-events-none shadow-lg
      absolute bottom-full left-1/2 -translate-x-1/2 group-hover/tooltip:opacity-100 duration-200"
  >
    <ul class="pointer-events-none">
      {
        technologies.slice(4).map((tech) => (
          <li
            class="
              mb-1
              pointer-events-none
              last:mb-0
            "
          >
            <Tooltip tech={tech} />
          </li>
        ))
      }
    </ul>
  </div>
</div>
