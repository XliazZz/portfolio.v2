---
import Tooltip from "../../base/Tooltip.astro";

interface Props {
  technologies: Array<{ name: string; icon: string }>;
}
const { technologies } = Astro.props;
---

<ul class="inline-flex flex-wrap
      items-center gap-2">
  {
    technologies.slice(0, 4).map((tech) => (
      <li
        class="
          w-8 h-8
          p-1.5
          text-gray-500 
          bg-gray-50 dark:bg-gray-900 dark:text-indigo-300 dark:border-indigo-900 dark:hover:bg-indigo-950 dark:hover:text-indigo-100
          rounded-lg border border-gray-200
          transition-all
          relative group hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 duration-200
          md:w-9 md:h-9
        "
        data-shape="circular"
        tabindex="0"
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          class="
            w-full h-full
          "
        >
          <use href={`/techsSprite.svg#${tech.icon}`} />
        </svg>
        <Tooltip text={tech.name} />
      </li>
    ))
  }
</ul>
