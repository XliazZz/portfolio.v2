---
const history = [
  { metric: "+10", type: "Proyectos" },
  { metric: "+2", type: "Años Exp." },
  { metric: "+25", type: "Tecnologías" },
  { metric: "+8", type: "Colaboraciones" },
];
---

<header
  class="overflow-hidden p-4
      md:p-8
      bg-gradient-to-br from-white to-indigo-50 dark:from-gray-900 dark:to-gray-950
      rounded-2xl border border-indigo-100 dark:border-indigo-950
      shadow-lg
      relative
      lg:mb-12 lg:shadow-xl lg:mx-auto"
>
  <div
    class="w-32 h-32
      bg-gradient-to-br
      from-indigo-500/10 to-purple-600/10
      dark:from-indigo-900 dark:to-purple-800
      rounded-full
      absolute top-0 right-0 -translate-y-16 translate-x-16"
  >
  </div>
  <div
    class="w-40 h-40
      bg-gradient-to-tr from-indigo-500/5 to-purple-600/5
      dark:from-indigo-900 dark:to-purple-800
      rounded-full
      absolute bottom-0 left-0 -translate-x-20 translate-y-20"
  >
  </div>

  <div class="flex flex-col
      relative items-center">
    <div class="flex-1 lg:text-center">
      <span
        class="inline-flex
          mb-4 px-3 py-1
          text-xs md:text-sm font-medium text-indigo-600 tracking-widest
          bg-indigo-100 dark:bg-indigo-700 dark:text-indigo-200
          rounded-full
          items-center gap-2 uppercase
          xl:text-xs"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="m12 2l3.104 6.728l7.358.873l-5.44 5.03l1.444 7.268L12 18.28L5.534 21.9l1.444-7.268L1.538 9.6l7.359-.873z"
          ></path>
        </svg>
        Experiencia Comprobada
      </span>

      <h2
        class="mb-4
          text-xl font-bold font-heading text-gray-900 leading-tight dark:text-white
          sm:mb-6 sm:text-3xl
          md:mb-3 md:text-4xl
          lg:text-3xl
          xl:text-4xl"
      >
        Desarrollo
        <span
          class="text-transparent
            bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600
            dark:from-indigo-400 dark:to-purple-400"
        >
          Profesional
        </span>
      </h2>

      <p
        class="max-w-lg
          text-gray-600 font-body dark:text-gray-300
           hidden md:flex"
      >
        Soluciones tecnológicas innovadoras respaldadas por años de experiencia
        y proyectos exitosos.
      </p>
    </div>

    <div
      class="grid grid-cols-2
        gap-6
        sm:gap-8
        md:mt-6 md:grid-rows-1 md:grid-cols-4
        lg:mt-8"
    >
      {
        history.map((item) => (
          <div
            class="
              p-1 py-auto
              text-center
              bg-white dark:bg-gray-950 dark:border-slate-900
              rounded-xl border border-gray-100
              shadow-sm transition-all
              hover:shadow-md hover:-translate-y-1
              sm:p-2
              lg:p-2
            "
          >
            <h3
              class="
                text-2xl font-bold text-indigo-600 font-heading dark:text-indigo-500
                2xl:text-3xl
              "
            >
              {item.metric}
            </h3>
            <p
              class="
                text-sm text-gray-500 font-body dark:text-gray-400
              "
            >
              {item.type}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</header>
