---
import Tooltip from "../ui/Tooltip.astro";
import TooltipCard from "./TooltipCard.astro";

interface Props {
  technologies: Array<{ name: string; icon: string }>;
}

const { technologies } = Astro.props;
const remainingCount = technologies.length - 4;
---

<div
  class="inline-flex flex-wrap
      mb-4
      items-center gap-2 relative ocultar-en-movil"
>
  <ul class="inline-flex flex-wrap
      items-center gap-2">
    {
      technologies.slice(0, 4).map((tech) => (
        <li
          class="
            w-8 h-8
            p-1.5
            text-gray-500
            bg-gray-50
            rounded-lg border border-gray-200
            transition-all
            relative group hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 duration-200
            md:w-9 md:h-9
          "
          data-shape="circular"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="
                w-full h-full
              "
          >
            <use href={`/techsSprite.svg#${tech.icon}`} />
          </svg>
          <Tooltip text={tech.name} />
        </li>
      ))
    }
  </ul>

  {
    remainingCount > 0 && (
      <div
        class="
          relative group/tooltip
        "
      >
        <button
          class="
            w-8 h-8
            text-gray-500 font-medium
            bg-gray-100
            rounded-lg border border-gray-200
            transition-all
            hover:text-indigo-600 hover:bg-indigo-100 hover:border-indigo-200 duration-200
            md:w-9 md:h-9
          "
          data-shape="circular"
        >
          +{remainingCount}
        </button>

        <div
          class="
            z-10
            mb-2 px-3 py-2
            text-white text-xs whitespace-nowrap
            bg-gray-900
            rounded-lg
            opacity-0 transition-opacity pointer-events-none shadow-lg
            absolute bottom-full left-1/2 -translate-x-1/2 group-hover/tooltip:opacity-100 duration-200
          "
        >
          <ul
            class="
              pointer-events-none
            "
          >
            {technologies.slice(5).map((tech) => (
              <li
                class="
                  mb-1
                  pointer-events-none
                  last:mb-0
                "
              >
                <TooltipCard tech={tech} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</div>

<style>
  @media (max-width: 768px) {
    .ocultar-en-movil {
      display: none;
    }
  }
</style>
