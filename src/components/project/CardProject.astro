---
import TechChips from "./TechChips.astro";
import CardLinks from "./CardLinks.astro";
import Badge from "../ui/Badge.astro";

interface Props {
  title: string;
  demoUrl?: string;
  githubUrl?: string;
  technologies: Array<{ name: string; icon: string }>;
  featuredImage: string;
  description: string;
  rol: string;
  category: string;
}

const {
  title,
  demoUrl,
  githubUrl,
  technologies,
  featuredImage,
  description,
  rol,
  category,
} = Astro.props;
---

<div
  class="flex flex-col overflow-hidden
      w-full h-full max-w-[26rem]
      bg-white
      rounded-xl border border-gray-200
      shadow-sm transition-all
      justify-between hover:shadow-md duration-300 hover:border-indigo-100"
>
  <div class="h-max
      border-b border-gray-100
      relative group">
    <img
      class="object-cover
        w-full h-48
        rounded-t-xl
        transition-transform
        group-hover:scale-105 duration-300"
      src={featuredImage}
      alt={`Captura del proyecto ${title}`}
      width={400}
      height={200}
    />
    <div
      class="bg-indigo-600
        rounded-t-xl
        opacity-0 transition-opacity
        absolute inset-0 group-hover:opacity-5 duration-300"
    >
    </div>
  </div>

  <div class="w-full h-max
      px-4
      rounded">
    <div
      class="flex
        w-full
        mb-4
        items-start justify-between gap-2"
    >
      <h6
        class="font-sans font-bold text-lg text-gray-800 font-heading
          antialiased"
      >
        {title}
      </h6>

      <div class="flex flex-shrink-0 gap-2">
        <Badge
          text={rol}
          type="role"
          roleType={rol as "Full-Stack" | "Front-End" | "Back-End"}
        />
        <Badge text={category} type="category" />
      </div>
    </div>

    <p
      class="mb-4
        font-body text-sm text-gray-600 leading-relaxed
        antialiased line-clamp-3"
    >
      {description}
    </p>

    <TechChips technologies={technologies} />
  </div>

  <CardLinks {...{ demoUrl, githubUrl }} />
</div>
