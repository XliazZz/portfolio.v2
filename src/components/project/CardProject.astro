---
import TechChips from "./TechChips/TechChips.astro";
import CardLinks from "./CardLinks.astro";
import Badge from "../base/Badge.astro";
import Tooltip from "../base/Tooltip.astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  demoUrl?: string;
  githubUrl?: string;
  technologies: Array<{ name: string; icon: string }>;
  featuredImage: string;
  description: string;
  rol: string;
  category: string;
  rolDescription: string;
}

const {
  title,
  demoUrl,
  githubUrl,
  technologies,
  featuredImage,
  description,
  rol,
  category,
  rolDescription,
} = Astro.props;

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: title,
  description: description,
  url: demoUrl || githubUrl || Astro.url.href,
  image: featuredImage,
  programmingLanguage: technologies.map((t) => t.name),
  keywords: technologies.map((t) => t.name).join(", "),
  author: {
    "@type": "Person",
    name: "Elías Martínez",
    url: Astro.url.base,
  },
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(projectSchema)}
/>

<div
  class="flex flex-col overflow-hidden w-full h-full max-w-[26rem] m-0 bg-white rounded-xl border border-gray-200 shadow-sm transition-all justify-between hover:shadow-md duration-300 hover:border-indigo-100"
>
  <div class="h-max border-b border-gray-100 relative group">
    <Image
      class="object-cover w-full sm:h-48 h-32 rounded-t-xl transition-transform group-hover:scale-105 duration-300 xl:h-60"
      src={featuredImage}
      alt={`Captura del proyecto ${title}`}
      width={768}
      height={432}
      sizes="(max-width: 640px) 100vw, 400px"
      loading="lazy"
      decoding="async"
    />

    <div
      class="bg-indigo-600 rounded-t-xl opacity-0 transition-opacity absolute inset-0 group-hover:opacity-5 duration-300"
    >
    </div>
  </div>

  <div class="flex-grow flex flex-col w-full rounded p-2 md:pt-3 lg:pt-2">
    <div
      class="flex w-full sm:mb-4 items-center justify-between gap-0 md:mb-2 lg:gap-2"
    >
      <h4
        class="mx-auto font-sans font-bold sm:text-lg text-gray-800 font-heading text-center antialiased py-2 md:py-auto md:my-0 md:m-0 md:mt-0 lg:mx-0 lg:mt-0 lg:text-left lg:text-base xl:text-xl"
      >
        {title}
      </h4>

      <div
        class="flex flex-shrink-0 my-auto md:block lg:flex gap-2 md:space-y-2 lg:space-y-0"
      >
        <div class="relative group inline-flex items-center" tabindex="0">
          <Badge
            text={rol}
            type="role"
            roleType={rol as "Full-Stack" | "Front-End" | "Back-End"}
          />
          <Tooltip text={rolDescription} classProp="w-[200px] max-w-lg" />
        </div>

        <Badge text={category} type="category" />
      </div>
    </div>

    <p
      class="mb-4 font-body text-sm text-gray-600 leading-relaxed antialiased line-clamp-3
        **hidden sm:block** md:text-base md:pt-5 lg:pt-0"
    >
      {description}
    </p>

    <div class="lg:mt-auto xl:mt-2">
      <TechChips technologies={technologies} />
    </div>

    <CardLinks {...{ demoUrl, githubUrl }} />
  </div>
</div>
