---
const listItems = [
  {
    title: "Diseño Responsive:",
    text: "Experiencias optimizadas para todos los dispositivos.",
  },
  {
    title: "Rendimiento:",
    text: "Aplicaciones rápidas y eficientes que mejoran la experiencia.",
  },
  {
    title: "Código Limpio:",
    text: "Desarrollo mantenible y escalable usando mejores prácticas.",
  },
  {
    title: "Comunicación Clara:",
    text: "Trabajo colaborativo y transparencia en cada proyecto.",
  },
];
---

<section
  class="overflow-hidden
      py-14 px-3
      bg-gray-50
      dark:bg-gray-800
      sm:py-16
      md:pt-24 md:px-7 md:pb-0
      lg:py-28 lg:px-0
      2xl:pt-40"
>
  <div
    class="max-w-[90rem]
      px-0 mx-auto
      sm:max-w-full
      sm:px-1
      lg:px-8"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 md:gap-x-4 md:items-stretch">
      <div class="relative">
        <div
          class="text-sm tracking-widest
            absolute left-[40%] -top-6 rotate-0 ocultar-en-movil
            md:-left-16 md:top-16 md:rotate-[-90deg]
            lg:top-14"
        >
          <div
            class="flex
              items-center justify-center gap-2 ocultar-en-tablet"
          >
            <div class="w-10 h-[2px]
                bg-indigo-600"></div>
            <p class="font-body
                uppercase">Sobre Mí</p>
          </div>
        </div>

        <h2
          class="mx-auto
            text-2xl font-bold leading-tight font-heading text-center
            sm:text-3xl
            md:text-3xl
            lg:mb-4 lg:pl-10 lg:text-left"
        >
          Creando Experiencias <br /> Digitales Excepcionales
        </h2>

        <div
          class="my-5
            lg:max-w-2xl lg:ml-6 lg:mt-20 lg:col-start-2"
        >
          <p
            class="text-base font-semibold leading-6 text-indigo-500 text-center
              uppercase
              lg:text-left"
          >
            Desarrollo Centrado en el Usuario
          </p>
          <h4
            class="mt-4
              text-2xl font-extrabold leading-8 text-gray-900 font-heading
              ocultar-en-movil
              sm:text-3xl sm:leading-9
              md:text-xl md:text-gray-700 md:mb-6"
          >
            Soluciones que Marcan la Diferencia
          </h4>

          <ul
            class="mt-5 space-y-3
              font-medium
              md:mt-0
              lg:mt-8"
          >
            {
              listItems.map((item) => (
                <li
                  class="
                    flex
                    my-3
                    items-start
                    sm:my-4
                    md:my-5
                    lg:my-0 lg:col-span-1
                  "
                >
                  <div
                    class="
                      flex-shrink-0
                    "
                  >
                    <svg
                      class="
                        w-5 h-5
                        text-indigo-600
                      "
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </div>
                  <p
                    class="
                      ml-3
                      leading-5 text-gray-600 text-sm
                      sm:text-[16px]
                      md:text-base
                      lg:text-base
                    "
                  >
                    <strong
                      class="
                        font-heading
                      "
                    >
                      {item.title}
                    </strong>{" "}
                    {item.text}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="mt-5 relative ocultar-en-movil lg:mt-0
            md:relative md:min-h-[28rem] md:flex md:items-end md:justify-center md:overflow-hidden"
      >
        <img
          class="hidden md:block md:absolute md:bottom-0 md:left-1/2 md:-translate-x-1/2
           md:w-[90%] md:mb-0"
          src="https://cdn.rareblocks.xyz/collection/celebration/images/team/1/blob-shape.svg"
          alt=""
        />

        <img
          class="w-full relative xl:max-w-lg xl:mx-auto
           md:absolute md:bottom-0 md:left-1/2 md:-translate-x-1/2
           md:mb-0 md:h-auto"
          src="https://res.cloudinary.com/do5ubt5g0/image/upload/v1761519022/Untitled_Project_2_ywtagj.png"
          alt=""
        />
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .ocultar-en-movil {
      display: none;
    }
  }

  @media (max-width: 870px) {
    .ocultar-en-tablet {
      display: none;
    }
  }
</style>
