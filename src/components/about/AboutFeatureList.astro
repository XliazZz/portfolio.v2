---
interface ListItem {
  title: string;
  text: string;
}

interface Props {
  items: ListItem[];
}

const { items } = Astro.props;
---

<ul class="mt-5 space-y-3
    font-medium
    md:mt-0
    xl:mt-6">
  {
    items.map((item) => (
      <li
        class="
            flex
            my-3
            items-start
            sm:my-4
            md:my-5
            lg:my-4 lg:col-span-1"
      >
        <div
          class="flex-shrink-0"
        >
          <svg
            class="w-5 h-5 text-indigo-600"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
        <p
          class="ml-3 leading-5 text-gray-600 text-sm
              sm:text-[16px]
              md:text-base
              xl:text-lg"
        >
          <strong
            class="font-heading"
          >
            {item.title}
          </strong>{" "}
          {item.text}
        </p>
      </li>
    ))
  }
</ul>
