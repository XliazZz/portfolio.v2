---
import CardProject from "./project/CardProject.astro";
import projectsData from "../data/projectsCard.json";
import HeaderProjects from "./project/HeaderProjects.astro";
---

<section
  class="py-14
      bg-gray-50
      relative
      lg:py-28
      xl:py-22
      2xl:py-36"
>
  <div
    class="max-w-4xl px-4
      sm:mx-8
      md:mx-10
      lg:mx-auto lg:max-w-5xl lg:px-0
      xl:max-w-6xl xl:px-0
      2xl:max-w-7xl"
  >
    <HeaderProjects />
    <ul
      class="grid grid-cols-2
        space-y-8 mt-12
        gap-2 gap-y-4 sm:gap-6 items-stretch
        md:mt-16 md:gap-9
        lg:grid-cols-3 lg:mt-14 lg:gap-4 lg:w-full lg:mx-auto lg:gap-y-8
        xl:gap-10
        2xl:mt-20"
    >
      {projectsData.map((project) => <CardProject {...project} />)}
    </ul>
  </div>
</section>

<style></style>
