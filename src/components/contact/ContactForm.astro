---
import Select from "../ui/Select.astro";
import formOptionsData from "../../data/formOptionsData.json";
import Label from "../ui/Label.astro";
import Input from "../ui/Input.astro";
import Button from "../ui/Button.astro";
---

<form
  id="contactForm"
  action="#"
  method="POST"
  class="w-full lg:py-12 lg:pl-8 px-6"
>
  <div class="w-full">
    <div class="grid grid-cols-2 gap-x-4 lg:gap-x-8 gap-y-6">
      <div>
        <Label for="name" text="Nombre completo" />
        <div class="mt-1">
          <Input
            id="name"
            type="text"
            name="user_name"
            autoComplete="name"
            placeholder="Escribe tu nombre"
            required
          />
        </div>
      </div>

      <div>
        <Label for="email" text="Email" />
        <div class="mt-1">
          <Input
            id="email"
            type="email"
            name="user_email"
            autoComplete="email"
            required
            placeholder="Escribe tu email"
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <Label for="project_type" text="Tipo de proyecto *" />
        <div class="mt-1">
          <Select
            name="project_type"
            id="project_type"
            required
            options={formOptionsData.projectOptions}
          />
        </div>
      </div>

      <div class="sm:col-span-2">
        <Label for="budget" text="Presupuesto estimado" />
        <div class="mt-1">
          <Select
            name="budget"
            id="budget"
            options={formOptionsData.budgetOptions}
          />
        </div>
      </div>

      <div class="col-span-2">
        <Label for="delivery_time" text="Tiempo de entrega esperado" />
        <div class="mt-1">
          <Select
            name="delivery_time"
            id="delivery_time"
            options={formOptionsData.deliveryTimeOptions}
          />
        </div>
      </div>

      <div class="col-span-2">
        <Label for="message" text="Cuéntame sobre tu proyecto *" />
        <textarea
          name="message"
          id="message"
          rows="4"
          required
          placeholder="Describe tu proyecto, objetivos, funcionalidades necesarias, público objetivo, etc."
          class="block w-full rounded-lg border-0 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 font-body transition duration-200 hover:bg-white lg:text-base"
        ></textarea>
      </div>
    </div>

    <div class="mt-6 flex justify-end">
      <Button type="submit" text="Enviar consulta" icon="sendIcon" />
    </div>
  </div>
</form>

<script>
  import { sendForm } from "../../scripts/sendForm.js";
  document.addEventListener("DOMContentLoaded", sendForm);
</script>
