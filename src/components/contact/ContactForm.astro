---
const label = "font-mono text-label-md tracking-wider text-on-surface-variant";
const field =
  "w-full rounded-sm border border-outline-variant/40 bg-surface-container-lowest/80 px-4 py-2.5 text-body-md text-on-surface transition-colors placeholder:text-outline focus:border-tertiary focus:outline-none";
---

<form
  id="contactForm"
  action="#"
  method="POST"
  class="flex flex-col gap-4"
  aria-label="Formulario de contacto"
>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <label for="name" class={label} data-en="// NAME">// NOMBRE</label>
      <input
        id="name"
        type="text"
        name="user_name"
        autocomplete="name"
        required
        placeholder="Ada Lovelace"
        class={field}
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="email" class={label}>// EMAIL</label>
      <input
        id="email"
        type="email"
        name="user_email"
        autocomplete="email"
        required
        placeholder="ada@company.com"
        class={field}
      />
    </div>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="company" class={label} data-en="// COMPANY (OPTIONAL)"
      >// EMPRESA (OPCIONAL)</label
    >
    <input
      id="company"
      type="text"
      name="company"
      autocomplete="organization"
      placeholder="Acme Inc."
      class={field}
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="message" class={label} data-en="// MESSAGE *"
      >// MENSAJE *</label
    >
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      placeholder="Puesto, stack, modalidad…"
      data-en-placeholder="Role, stack, work arrangement…"
      class={field}></textarea>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
    <span class="flex items-center gap-2 font-mono text-label-sm text-outline">
      <span class="h-2 w-2 rounded-full bg-tertiary"></span>
      <span data-en="SECURE DELIVERY // HTTPS">ENVÍO SEGURO // HTTPS</span>
    </span>
    <button
      type="submit"
      name="submit_form"
      class="inline-flex items-center gap-2 rounded-sm bg-tertiary px-6 py-2.5 font-mono text-label-md font-semibold tracking-wider text-on-tertiary shadow-[0_0_20px_rgba(39,218,240,0.3)] transition-all duration-300 hover:bg-tertiary-fixed"
    >
      <span data-en="SEND MESSAGE ->">ENVIAR MENSAJE -&gt;</span>
    </button>
  </div>
</form>

<script>
  import { sendForm } from "../../../public/utils/sendForm";
  sendForm();
</script>
