---
interface Props {
  icon: string;
  href?: string;
  name?: string;
}

const { icon, href, name } = Astro.props;
---

<a
  href={href}
  aria-label={name}
  target="_blank"
  rel="noopener noreferrer"
  class="flex-shrink-0 flex
      w-10 h-10
      bg-white dark:bg-indigo-950
      border border-indigo-200 rounded-lg dark:border-indigo-700
      shadow-sm transition-all
      items-center justify-center hover:shadow-md duration-300 hover:scale-110 hover:bg-indigo-50 group
      md:w-12 md:h-12 dark:hover:bg-gray-950"
>
  <div
    class="text-indigo-600 dark:text-white
      transition-colors
      hover:text-indigo-700 dark:hover:text-white"
  >
    <svg
      class="flex-shrink-0
        w-5 h-5
        md:w-6 md:h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <use href={`/techsSprite.svg#${icon}`}></use>
    </svg>
  </div>
</a>
