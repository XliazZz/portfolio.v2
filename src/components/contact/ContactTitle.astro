---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<div
  class="w-32 h-32
      bg-gradient-to-r from-indigo-400 to-purple-200 dark:from-indigo-800 dark:to-purple-950
      rounded-full
      opacity-50
      absolute -top-6 -left-6 blur-2xl"
  aria-hidden="true"
>
</div>

<h2
  id={id}
  class="mb-6
      text-3xl font-bold font-heading tracking-tight text-gray-900 dark:text-white leading-tight
      relative drop-shadow-[0_4px_12px_rgba(99,102,241,0.3)]
      sm:text-3xl
      md:text-4xl
      lg:text-3.5xl
      xl:text-4xl"
>
  Transformemos tu idea
  <span
    class="block
      text-transparent
      bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400
      drop-shadow-[0_4px_8px_rgba(99,102,241,0.4)]"
  >
    en realidad digital
  </span>
  <span
    class="block
      w-24 h-1.5
      mt-4
      bg-gradient-to-r from-indigo-500 to-purple-500
      rounded-full
      shadow-lg shadow-indigo-500/30"
    aria-hidden="true"></span>
</h2>
