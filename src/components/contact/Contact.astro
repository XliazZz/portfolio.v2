---
import ContactForm from "./ContactForm.astro";
import ContactLi from "./ContactLi.astro";
import ContactSocialMedia from "./ContactSocialMedia.astro";
import Tooltip from "../ui/Tooltip.astro";
import contactAndSocial from "../../data/contactAndSocial.json"
---

<div class="relative w-full text-black overflow-hidden min-h-screen">
  <div
    class="absolute inset-0 -z-10 h-full w-full bg-gray-50 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]"
  >
    <div
      class="absolute -left-[70%] right-0 top-20 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-fuchsia-400 opacity-20 blur-[100px]"
    >
    </div>
  </div>
  <div class="absolute top-0 -z-10 h-full left-1/2 w-1/2 bg-white">
    <div
      class="absolute bottom-auto left-auto right-0 top-0 h-[500px] w-[500px] -translate-x-[30%] translate-y-[20%] rounded-full bg-[rgba(173,109,244,0.5)] opacity-50 blur-[80px]"
    >
    </div>
  </div>

  <div class="relative z-10 xl:max-w-6xl max-w-4xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-screen">
      <div class="relative w-full">
        <div class="py-20 lg:py-40 w-full h-full">
          <div class="px-6 lg:px-0 lg:pr-8 h-full flex items-center">
            <div class="w-full">
              <div class="relative">
                <div
                  class="absolute -top-6 -left-6 w-32 h-32 bg-gradient-to-r from-indigo-400 to-purple-200 rounded-full blur-2xl opacity-50"
                >
                </div>

                <h2
                  class="relative text-4xl sm:text-5xl font-bold font-heading tracking-tight text-gray-900 mb-6 leading-tight drop-shadow-[0_4px_12px_rgba(99,102,241,0.3)]"
                >
                  Transformemos tu idea
                  <span
                    class="block text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 drop-shadow-[0_4px_8px_rgba(99,102,241,0.4)]"
                  >
                    en realidad digital
                  </span>
                  <span
                    class="block w-24 h-1.5 bg-gradient-to-r from-indigo-500 to-purple-500 mt-4 rounded-full shadow-lg shadow-indigo-500/30"
                  ></span>
                </h2>

                <p
                  class="relative text-lg leading-8 text-gray-700 font-body bg-white/80 p-6 rounded-xl backdrop-blur-sm border border-indigo-100 shadow-sm hover:shadow-md transition-shadow duration-300"
                >
                  💡 Si tenés una idea, un negocio o querés mejorar tu presencia
                  online, estoy listo para ayudarte a hacerlo realidad.
                  Escribime y empecemos a crear algo grande.
                </p>

                <div class="mt-8 space-y-4">
                  <h3
                    class="text-lg font-semibold text-gray-800 flex items-center gap-2"
                  >
                    <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
                    Contacto directo
                  </h3>
                  <dl class="space-y-3 text-base leading-7">
                    {
                      contactAndSocial.contactMethods.map((method) => (
                        <ContactLi
                          type={method.type}
                          value={method.value}
                          href={method.href}
                          icon={method.icon}
                        />
                      ))
                    }
                  </dl>
                </div>

                <div class="mt-12">
                  <span class="flex items-center">
                    <span
                      class="h-px flex-1 bg-gradient-to-r from-transparent via-indigo-300 to-transparent mb-4"
                    ></span>
                    <span
                      class="mb-4 shrink-0 px-6 text-sm font-semibold text-gray-600 text-center bg-white/80 backdrop-blur-sm py-2 rounded-full border border-indigo-100 shadow-sm"
                    >
                      Seguime en redes
                    </span>
                    <span
                      class="h-px flex-1 bg-gradient-to-r from-transparent via-indigo-300 to-transparent mb-4"
                    ></span>
                  </span>
                  <ul
                    class="flex items-center justify-center gap-3 p-3 rounded-2xl bg-white/80 backdrop-blur-sm border border-indigo-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    {
                      contactAndSocial.socialMedia.map((social) => (
                        <li class="relative group">
                          <ContactSocialMedia
                            icon={social.icon}
                            href={social.href}
                            name={social.value}
                          />
                          <Tooltip text={social.type} />
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="relative w-full">
        <div
          class="w-full h-full flex items-center justify-center py-20 lg:py-40"
        >
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </div>
</div>
