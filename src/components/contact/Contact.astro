---
import ContactForm from "./ContactForm.astro";
import ContactLi from "./ContactLi.astro";
import ContactSocialMedia from "./ContactSocialMedia.astro";
import Tooltip from "../ui/Tooltip.astro";
import contactAndSocial from "../../data/contactAndSocial.json";
---

<div
  class="overflow-hidden
      w-full min-h-screen
      py-20
      text-black
      bg-white
      relative
      lg:py-40
      sm:px-3"
>
  <div
    class="h-full w-full
      bg-gray-50 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]
      absolute inset-0 -z-10 ocultar-en-movil"
  >
    <div
      class="h-[310px] w-[310px]
        m-auto
        bg-fuchsia-400
        rounded-full
        opacity-20
        absolute -left-[70%] right-0 top-20 -z-10 blur-[100px]"
    >
    </div>
  </div>
  <div class="h-full w-1/2
      bg-white
      absolute top-0 -z-10 left-1/2">
    <div
      class="h-[500px] w-[500px]
        bg-[rgba(173,109,244,0.5)]
        rounded-full
        opacity-50
        absolute bottom-auto left-auto right-0 top-0 -translate-x-[30%] translate-y-[20%] blur-[80px]"
    >
    </div>
  </div>

  <div class="z-10
      max-w-4xl
      mx-auto
      relative
      xl:max-w-7xl">
    <div class="grid grid-cols-1
        min-h-screen
        lg:grid-cols-2">
      <div class="w-full
          relative">
        <div class="w-full h-full">
          <div
            class="flex
              h-full
              px-6
              items-center
              lg:px-0 lg:pr-8"
          >
            <div class="w-full">
              <div class="relative">
                <div
                  class="w-32 h-32
                    bg-gradient-to-r from-indigo-400 to-purple-200
                    rounded-full
                    opacity-50
                    absolute -top-6 -left-6 blur-2xl"
                >
                </div>

                <h2
                  class="mb-6
                    text-3xl font-bold font-heading tracking-tight text-gray-900 leading-tight
                    relative drop-shadow-[0_4px_12px_rgba(99,102,241,0.3)]
                    sm:text-4xl
                    md:text-5xl"
                >
                  Transformemos tu idea
                  <span
                    class="block
                      text-transparent
                      bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600
                      drop-shadow-[0_4px_8px_rgba(99,102,241,0.4)]"
                  >
                    en realidad digital
                  </span>
                  <span
                    class="block
                      w-24 h-1.5
                      mt-4
                      bg-gradient-to-r from-indigo-500 to-purple-500
                      rounded-full
                      shadow-lg shadow-indigo-500/30"
                  ></span>
                </h2>

                <p
                  class="p-6
                    text-lg leading-8 text-gray-700 font-body
                    bg-white/80
                    rounded-xl border border-indigo-100
                    shadow-sm transition-shadow
                    relative backdrop-blur-sm hover:shadow-md duration-300 ocultar-en-movil"
                >
                  💡 Si tenés una idea, un negocio o querés mejorar tu presencia
                  online, estoy listo para ayudarte a hacerlo realidad.
                  Escribime y empecemos a crear algo grande.
                </p>

                <div class="mt-8 space-y-4">
                  <h3
                    class="flex
                      text-lg font-semibold text-gray-800
                      items-center gap-2 ocultar-en-movil"
                  >
                    <span
                      class="w-2 h-2
                        bg-indigo-500
                        rounded-full"
                    ></span>
                    Contacto directo
                  </h3>
                  <dl
                    class="space-y-3
                      text-base leading-7"
                  >
                    {
                      contactAndSocial.contactMethods.map((method) => (
                        <ContactLi
                          type={method.type}
                          value={method.value}
                          href={method.href}
                          icon={method.icon}
                        />
                      ))
                    }
                  </dl>
                </div>

                <div class="mt-6
                    lg:mt-12">
                  <span
                    class="flex
                      items-center ocultar-en-movil"
                  >
                    <span
                      class="flex-1
                        h-px
                        mb-4
                        bg-gradient-to-r from-transparent via-indigo-300 to-transparent"
                    ></span>
                    <span
                      class="mb-4 px-6 py-2
                        text-sm font-semibold text-gray-600 text-center
                        bg-white/80
                        rounded-full border border-indigo-100
                        shadow-sm
                        shrink-0 backdrop-blur-sm"
                    >
                      Seguime en redes
                    </span>
                    <span
                      class="flex-1
                        h-px
                        mb-4
                        bg-gradient-to-r from-transparent via-indigo-300 to-transparent"
                    ></span>
                  </span>
                  <ul
                    class="flex
                      p-3
                      bg-white/80
                      rounded-2xl border border-indigo-100
                      shadow-sm transition-all
                      items-center justify-center gap-3 backdrop-blur-sm hover:shadow-md duration-300"
                  >
                    {
                      contactAndSocial.socialMedia.map((social) => (
                        <li
                          class="
                            relative group
                          "
                        >
                          <ContactSocialMedia
                            icon={social.icon}
                            href={social.href}
                            name={social.value}
                          />
                          <Tooltip text={social.type} />
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full
          relative">
        <div
          class="flex
            w-full h-full
            pt-20
            items-center justify-center
            lg:py-40"
        >
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .ocultar-en-movil {
      display: none;
    }
  }
</style>
