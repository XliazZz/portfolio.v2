---
import Button from "./ui/Button.astro";

const sections = [
  { name: "Proyectos", href: "#" },
  { name: "Sobre mí", href: "#" },
  { name: "Experiencia", href: "#" },
];
---

<div
  class="z-50
      w-full
      py-1
      bg-white
      top-0 dark:bg-gray-900
      lg:py-6 lg:relative"
>
  <nav
    class="z-10
      h-full
      mx-auto px-0 py-2.5
      sticky top-0 left-0 right-0
      lg:py-3 lg:border-none
      xl:max-w-6xl max-w-4xl"
  >
    <div class="flex
        items-center justify-between">
      <div class="flex space-x-2 items-center">
        <h2
          class="bg-gradient-to-r from-indigo-500 via-purple-700 to-indigo-500 bg-clip-text text-transparent font-heading text-4xl font-semibold py-1"
        >
          Code & Design
        </h2>
      </div>

      <div
        class="hidden
          lg:flex
          lg:items-center
          lg:space-x-8"
      >
        <ul
          class="flex space-x-11 text-base font-normal text-indigo-950/80 dark:text-white"
        >
          {
            sections.map((section) => (
              <li class="relative font-heading">
                <a
                  href={section.href}
                  class="border-b-2 border-transparent hover:border-indigo-500 transition-colors duration-300 pb-2.25 hover:text-indigo-500"
                >
                  {section.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="hidden
            gap-x-2
            lg:flex lg:items-center"
        >
          <Button
            text="Contacto"
            href="/contacto"
            icon="contactIcon"
            iconStyle="w-5 h-5"
            classStyle="text-white bg-gradient-to-r from-emerald-500 to-green-600 hover:from-green-600 hover:to-emerald-900 transition duration-500 px-6 py-2 text-lg rounded-xl font-semibold shadow-lg hover:shadow-xl"
          />
        </div>
      </div>

      <div class="flex
          items-center justify-center
          lg:hidden">
        <button
          class="text-slate-200
            focus:outline-none dark:text-white"
          ><svg
            stroke="currentColor"
            fill="currentColor"
            stroke-width="0"
            viewBox="0 0 20 20"
            aria-hidden="true"
            class="text-2xl text-slate-800
                dark:text-white focus:outline-none active:scale-110 active:text-red-500"
            height="1em"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              fill-rule="evenodd"
              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z"
              clip-rule="evenodd"></path></svg
          ></button
        >
      </div>
    </div>
  </nav>
</div>
