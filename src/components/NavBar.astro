---
import Button from "./ui/Button.astro";

const sections = [
  { name: "Sobre mí", href: "#about" },
  { name: "Proyectos", href: "#projects" },
  { name: "Servicios", href: "#services" },
];
---

<div
  class="z-50
      w-full
      py-4
      bg-white
      top-0
      md:py-6
      lg:py-2 lg:relative"
  data-main-nav
>
  <nav
    class="max-w-4xl
      px-5
      lg:z-10 lg:h-full lg:mx-auto lg:px-5 lg:py-3 lg:border-none lg:sticky lg:top-0 lg:left-0 lg:right-0 lg:max-w-5xl
      xl:max-w-6xl xl:px-0
      2xl:max-w-7xl"
  >
    <div class="flex
        justify-between
        lg:items-center">
      <div class="flex
          space-x-2
          items-center">
        <h2
          class="text-transparent font-heading font-semibold text-xl
            bg-gradient-to-r from-indigo-500 via-purple-700 to-indigo-500 bg-clip-text
            sm:text-2xl
            md:text-3xl"
        >
          Code & Design
        </h2>
      </div>

      <div class="hidden
          lg:flex lg:space-x-8 lg:items-center">
        <ul
          class="flex
            space-x-11
            text-base font-normal text-indigo-950/80
            lg:text-[15px] lg:space-x-8
            xl:text-lg xl:space-x-10
            dark:text-white"
        >
          {
            sections.map((section) => (
              <li
                class="
                  font-heading
                  relative
                "
              >
                <a
                  href={section.href}
                  class="
                      pb-2.25
                      border-b-2 border-transparent
                      transition-colors
                      hover:border-indigo-500 duration-300 hover:text-indigo-500
                    "
                >
                  {section.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="hidden
            gap-x-2
            lg:flex lg:items-center"
        >
          <Button
            text="Contacto"
            href="https://wa.me/5491135726318?text=Hola!%20Quiero%20info%20sobre%20mi%20página%20web"
            icon="contactIcon"
            iconStyle="w-5 h-5 xl:w-7 xl:h-7"
            classStyle="text-white bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-emerald-700 transition duration-200 px-6 py-2 text-base rounded-xl font-semibold  hover:shadow-lg xl:px-5 xl:text-lg"
          />
        </div>
      </div>
    </div>
  </nav>
</div>
