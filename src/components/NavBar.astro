---
import Button from "./ui/Button.astro";

const sections = [
  { name: "Proyectos", href: "#" },
  { name: "Sobre mí", href: "#" },
  { name: "Experiencia", href: "#" },
];
---

<div
  class="z-50
      w-full
      py-3
      bg-white
      top-0
      sm:py-4
      md:py-6
      lg:py-7 lg:relative"
>
  <nav
    class="max-w-4xl
      px-5
      lg:z-10 lg:h-full lg:mx-auto lg:px-0 lg:py-3 lg:border-none lg:sticky lg:top-0 lg:left-0 lg:right-0
      xl:max-w-7xl"
  >
    <div class="flex
        justify-between
        lg:items-center">
      <div class="flex
          space-x-2
          items-center">
        <h2
          class="text-transparent font-heading font-semibold text-xl
            bg-gradient-to-r from-indigo-500 via-purple-700 to-indigo-500 bg-clip-text
            sm:text-2xl
            md:text-3xl
            lg:py-1 lg:text-4xl"
        >
          Code & Design
        </h2>
      </div>

      <div class="hidden
          lg:flex lg:space-x-8 lg:items-center">
        <ul
          class="flex
            space-x-11
            text-base font-normal text-indigo-950/80
            dark:text-white"
        >
          {
            sections.map((section) => (
              <li
                class="
                  font-heading
                  relative
                "
              >
                <a
                  href={section.href}
                  class="
                      pb-2.25
                      border-b-2 border-transparent
                      transition-colors
                      hover:border-indigo-500 duration-300 hover:text-indigo-500
                    "
                >
                  {section.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="hidden
            gap-x-2
            lg:flex lg:items-center"
        >
          <Button
            text="Contacto"
            href="/contacto"
            icon="contactIcon"
            iconStyle="w-5 h-5"
            classStyle="text-white bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-emerald-700 transition duration-200 px-6 py-2 text-lg rounded-xl font-semibold  hover:shadow-lg"
          />
        </div>
      </div>

      <button
        data-collapse-toggle="mobile-menu-2"
        type="button"
        class="inline-flex
            p-1
            text-sm text-indigo-500
            rounded-lg
            items-center hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600
            lg:hidden"
        aria-controls="mobile-menu-2"
        aria-expanded="true"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 512 512"
          ><path
            d="M432 176H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16z"
            fill="currentColor"></path><path
            d="M432 272H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16z"
            fill="currentColor"></path><path
            d="M432 368H80c-8.8 0-16-7.2-16-16s7.2-16 16-16h352c8.8 0 16 7.2 16 16s-7.2 16-16 16z"
            fill="currentColor"></path></svg
        >
      </button>
    </div>
  </nav>
</div>
