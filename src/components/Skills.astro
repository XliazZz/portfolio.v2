---
import TechStackMarquee from "./skills/TechStackMarquee.astro";
import { skills, techs } from "../config/stackData.ts";
---

<section class="py-14
      bg-white
      sm:py-18
      lg:py-22
      xl:py-28">
  <div
    class="container
      max-w-4xl
      mx-auto
      lg:max-w-5xl
      xl:max-w-6xl
      2xl:max-w-7xl"
  >
    <div class="flex flex-col
        justify-center items-center">
      <span
        class="mb-3
          text-sm tracking-widest text-indigo-600 font-body
          uppercase dark:text-gray-400
          xl:text-sm"
      >
        Mi ecosistema de desarrollo
      </span>

      <span
        class="block
          mb-2
          text-2xl font-extrabold text-gray-700 font-heading
          dark:text-white
          sm:mb-4
          md:text-3xl
          xl:text-4xl"
      >
        Stack tecnológico
      </span>
      <p
        class="w-[80%]
          text-gray-600 text-sm font-body text-center
          dark:text-gray-300
          sm:text-md
          md:text-lg
          lg:w-full lg:text-base
          xl:text-lg"
      >
        Herramientas y plataformas que utilizo para crear soluciones web
      </p>
    </div>

    <div
      class="overflow-hidden
        w-full
        space-y-8 mt-10
        relative
        sm:mt-12
        lg:mt-12"
    >
      <TechStackMarquee data={skills} trackClass="marquee-track" />

      <TechStackMarquee data={techs} trackClass="marquee-track-reverse" />
    </div>
  </div>
</section>

<style></style>
