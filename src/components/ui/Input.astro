---
const {
  type = "text",
  id,
  name,
  autoComplete = "",
  placeholder = "",
  value,
  disabled = false,
  required = false,
} = Astro.props;
---

<input
  type={type}
  name={name}
  id={id}
  autocomplete={autoComplete}
  required={required}
  placeholder={placeholder}
  value={value}
  disabled={disabled}
  class="block w-full rounded-lg border-0 bg-gray-50 px-4 py-3 text-gray-900 shadow-sm shadow-indigo-700 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 font-body transition duration-200 hover:bg-white lg:text-base"
/>
