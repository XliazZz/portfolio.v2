---
interface Props {
  text: string;
  classProp?: string;
}

const { text, classProp } = Astro.props;

const baseClasses = `
    px-3 py-1.5 text-xs text-white font-body 
    bg-gray-900/95 rounded-md shadow-md 

    opacity-0 translate-y-3 pointer-events-none 
    
    absolute bottom-[140%] left-1/2 -translate-x-1/2 
    text-center leading-snug backdrop-blur-md z-20 

    transition-all duration-300 ease-out

    group-hover:opacity-100 group-hover:translate-y-0
    group-focus:opacity-100 group-focus:translate-y-0
`;

const finalClass = classProp
  ? `${baseClasses} ${classProp}`
  : `${baseClasses} whitespace-nowrap`;
---

<span class={finalClass}>
  {text}
</span>
