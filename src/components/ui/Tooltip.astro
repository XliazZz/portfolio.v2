---
interface Props {
  text: string;
}

const { text } = Astro.props as Props;
---

<span
  class="px-2.5 py-1
      whitespace-nowrap text-xs text-white font-body
      bg-gray-900 bg-opacity-90
      rounded-md
      shadow-md opacity-0 transition-opacity pointer-events-none
      absolute bottom-[125%] left-1/2 -translate-x-1/2 backdrop-blur-md group-hover:opacity-100 duration-200"
>
  {text}
</span>

<style></style>
