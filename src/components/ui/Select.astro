---
import Option from "./Option.astro";

interface Props {
  name: string;
  id: string;
  required?: boolean;
  disabled?: boolean;
  selected?: string;
  options?: Array<{ value: string; text: string }>;
}

const { name, id, required = false, disabled = false, selected } = Astro.props;
---

<select
  name={name}
  id={id}
  disabled={disabled}
  required={required}
  class="block
      w-full
      px-4 py-3
      text-gray-600 font-body
      bg-gray-50
      rounded-lg border-0
      shadow-sm shadow-indigo-700
      ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 focus:shadow-md focus:shadow-indigo-300 transition duration-200 hover:bg-white hover:shadow-indigo-300
      sm:text-sm sm:leading-6
      md:text-base
      lg:text-base"
>
  <slot />
  {
    Astro.props.options?.map((option) => (
      <Option
        value={option.value}
        text={option.text}
        selected={option.value === selected}
      />
    ))
  }
</select>
