---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<canvas
  id="node-sphere"
  class:list={[
    "cursor-grab touch-pan-y select-none active:cursor-grabbing",
    className,
  ]}></canvas>

<script>
  type V = [number, number, number];
  type Orbit = {
    r: number;
    tilt: [number, number];
    rgb: string;
    dash: number[];
    speed: number;
  };

  const canvas = document.getElementById("node-sphere") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Geodesic sphere: an icosahedron with every face split in four (42 nodes, 120 edges).
  const PHI = (1 + Math.sqrt(5)) / 2;
  const ico: V[] = [];
  for (const a of [-1, 1])
    for (const b of [-PHI, PHI]) ico.push([0, a, b], [a, b, 0], [b, 0, a]);
  const unit = ([x, y, z]: V): V => {
    const l = Math.hypot(x, y, z);
    return [x / l, y / l, z / l];
  };
  const adjacent = (i: number, j: number) =>
    Math.abs(
      Math.hypot(
        ico[i][0] - ico[j][0],
        ico[i][1] - ico[j][1],
        ico[i][2] - ico[j][2],
      ) - 2,
    ) < 1e-6;

  const nodes: V[] = ico.map(unit);
  const mids = new Map<string, number>();
  const mid = (i: number, j: number) => {
    const key = `${i}-${j}`;
    if (!mids.has(key))
      mids.set(
        key,
        nodes.push(
          unit([
            ico[i][0] + ico[j][0],
            ico[i][1] + ico[j][1],
            ico[i][2] + ico[j][2],
          ]),
        ) - 1,
      );
    return mids.get(key)!;
  };
  const edgeKeys = new Set<string>();
  const link = (a: number, b: number) =>
    edgeKeys.add(`${Math.min(a, b)},${Math.max(a, b)}`);
  const icoEdges: [number, number][] = [];
  for (let i = 0; i < 12; i++)
    for (let j = i + 1; j < 12; j++) {
      if (!adjacent(i, j)) continue;
      icoEdges.push([i, j]);
      for (let k = j + 1; k < 12; k++) {
        if (!adjacent(i, k) || !adjacent(j, k)) continue;
        const [ab, bc, ca] = [mid(i, j), mid(j, k), mid(i, k)];
        [
          [i, ab],
          [ab, j],
          [j, bc],
          [bc, k],
          [k, ca],
          [ca, i],
          [ab, bc],
          [bc, ca],
          [ca, ab],
        ].forEach(([a, b]) => link(a, b));
      }
    }
  const edges = [...edgeKeys].map(
    (e) => e.split(",").map(Number) as [number, number],
  );
  console.assert(
    nodes.length === 42 && edges.length === 120 && icoEdges.length === 30,
    "geodesic mesh",
  );
  const innerNodes = nodes
    .slice(0, 12)
    .map(([x, y, z]): V => [x * 0.42, y * 0.42, z * 0.42]);

  // The 12 icosahedron vertices sit on three perpendicular golden rectangles, four per plane (ico[i] lies
  // in the YZ, XY or XZ plane for i % 3 = 0, 1, 2). Each plane holds one stack cluster and its orbit runs
  // in that same plane, keeping the reference's dashed / solid / dotted ring styles.
  const clusters = [
    { rgb: "39,218,240", techs: ["REACT", "TYPESCRIPT", "ASTRO", "NEXT.JS"] },
    {
      rgb: "208,188,255",
      techs: ["NODE.JS", "PYTHON", "POSTGRESQL", "MONGODB"],
    },
    { rgb: "255,176,206", techs: ["TCP/UDP", "TLS", "CLAUDE CODE", "LINUX"] },
  ];
  console.assert(
    ico.every((v, i) => v[[0, 2, 1][i % 3]] === 0),
    "cluster planes",
  );
  const orbits: Orbit[] = [
    {
      r: 1.55,
      tilt: [0, Math.PI / 2],
      rgb: clusters[0].rgb,
      dash: [4, 6],
      speed: 0.7,
    },
    {
      r: 1.8,
      tilt: [Math.PI / 2, 0],
      rgb: clusters[1].rgb,
      dash: [],
      speed: -0.45,
    },
    { r: 2.05, tilt: [0, 0], rgb: clusters[2].rgb, dash: [1, 5], speed: 0.3 },
  ];

  const rotX = ([x, y, z]: V, a: number): V => [
    x,
    y * Math.cos(a) - z * Math.sin(a),
    y * Math.sin(a) + z * Math.cos(a),
  ];
  const rotY = ([x, y, z]: V, a: number): V => [
    x * Math.cos(a) + z * Math.sin(a),
    y,
    -x * Math.sin(a) + z * Math.cos(a),
  ];
  const rotZ = ([x, y, z]: V, a: number): V => [
    x * Math.cos(a) - y * Math.sin(a),
    x * Math.sin(a) + y * Math.cos(a),
    z,
  ];

  let size = 0;
  let t = 0;
  let yaw = 0.5;
  let pitch = -0.3;
  let spinV = 0;
  let pitchV = 0;
  let tiltX = 0;
  let tiltY = 0;
  let drag: { x: number; y: number } | null = null;
  let hover: { x: number; y: number } | null = null;

  const CAMERA = 6;
  const project = (p: V) => {
    const q = rotX(rotY(p, yaw + tiltY), pitch + tiltX);
    const f = CAMERA / (CAMERA - q[2]);
    const scale = (size / 2 - 10) / 2.3; // outer orbit projects to at most ~2.18 units, so this never clips
    return {
      x: size / 2 + q[0] * scale * f,
      y: size / 2 - q[1] * scale * f,
      z: q[2],
    };
  };
  const orbitPoint = (o: Orbit, a: number) =>
    project(
      rotZ(
        rotX([o.r * Math.cos(a), 0, o.r * Math.sin(a)], o.tilt[0]),
        o.tilt[1],
      ),
    );
  const dot = (x: number, y: number, r: number, color: string) => {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  };

  const draw = () => {
    ctx.clearRect(0, 0, size, size);
    ctx.globalCompositeOperation = "lighter";
    ctx.lineCap = "round";

    for (const o of orbits) {
      const front = new Path2D();
      const back = new Path2D();
      let prev = orbitPoint(o, 0);
      for (let i = 1; i <= 96; i++) {
        const p = orbitPoint(o, (i / 96) * Math.PI * 2);
        const path = p.z + prev.z > 0 ? front : back;
        path.moveTo(prev.x, prev.y);
        path.lineTo(p.x, p.y);
        prev = p;
      }
      ctx.setLineDash(o.dash);
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${o.rgb},0.18)`;
      ctx.stroke(back);
      ctx.strokeStyle = `rgba(${o.rgb},0.6)`;
      ctx.stroke(front);
    }
    ctx.setLineDash([]);

    // Inner icosahedron spinning against the shell.
    const inner = innerNodes.map((v) =>
      project(rotY(rotX(v, t * 0.5), -t * 0.9)),
    );
    const core = new Path2D();
    for (const [a, b] of icoEdges) {
      core.moveTo(inner[a].x, inner[a].y);
      core.lineTo(inner[b].x, inner[b].y);
    }
    ctx.lineWidth = 1;
    ctx.strokeStyle = "rgba(255,62,165,0.5)";
    ctx.stroke(core);

    // Shell edges bucketed by depth: back ones dim violet, front ones bright cyan.
    const P = nodes.map(project);
    const buckets = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];
    for (const [a, b] of edges) {
      const k = Math.min(3, Math.floor(((P[a].z + P[b].z) / 2 + 1) * 2));
      buckets[k].moveTo(P[a].x, P[a].y);
      buckets[k].lineTo(P[b].x, P[b].y);
    }
    [
      "160,120,255,0.14",
      "150,150,255,0.28",
      "90,200,250,0.55",
      "39,218,240,0.9",
    ].forEach((rgba, k) => {
      ctx.strokeStyle = `rgba(${rgba})`;
      ctx.stroke(buckets[k]);
    });
    ctx.lineWidth = 4;
    ctx.strokeStyle = "rgba(39,218,240,0.07)";
    ctx.stroke(buckets[3]);

    P.forEach((p, i) => {
      if (p.z < -0.3) return;
      const near =
        hover !== null && Math.hypot(p.x - hover.x, p.y - hover.y) < 36;
      const r = 1 + (p.z + 1) * 0.9;
      if (i >= 12) {
        if (near) {
          dot(p.x, p.y, r * 5, "rgba(255,62,165,0.15)");
          dot(p.x, p.y, r * 1.8, "rgba(255,62,165,0.95)");
        } else dot(p.x, p.y, r, `rgba(153,240,255,${0.35 + p.z * 0.5})`);
        return;
      }
      // Stack nodes: cluster colour plus a label pushed outward, fading as they turn away.
      const { rgb, techs } = clusters[i % 3];
      const a = Math.min(1, (p.z + 0.3) / 0.8);
      dot(p.x, p.y, r * (near ? 4 : 2.6), `rgba(${rgb},${0.14 * a})`);
      dot(p.x, p.y, r * (near ? 1.8 : 1.3), `rgba(${rgb},${a})`);
      const dx = p.x - size / 2;
      const dy = p.y - size / 2;
      const d = Math.hypot(dx, dy) || 1;
      ctx.font = `${near ? 600 : 500} ${near ? 11 : 10}px "JetBrains Mono", monospace`;
      ctx.textAlign = dx >= 0 ? "left" : "right";
      ctx.textBaseline = "middle";
      ctx.fillStyle = `rgba(${rgb},${near ? 1 : a * 0.85})`;
      ctx.fillText(
        techs[Math.floor(i / 3)],
        p.x + (dx / d) * 10,
        p.y + (dy / d) * 10,
      );
    });

    for (const o of orbits) {
      const p = orbitPoint(o, t * o.speed);
      const alpha = p.z > 0 ? 1 : 0.4;
      dot(p.x, p.y, 8, `rgba(${o.rgb},${0.18 * alpha})`);
      dot(p.x, p.y, 2.5, `rgba(${o.rgb},${alpha})`);
    }
  };

  const resize = () => {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    size = canvas.clientWidth;
    canvas.width = canvas.height = Math.round(size * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  };
  new ResizeObserver(resize).observe(canvas);
  document.fonts.ready.then(draw);

  const local = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  };
  canvas.addEventListener("pointerdown", (e) => {
    drag = local(e);
    spinV = pitchV = 0;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", (e) => {
    const p = local(e);
    if (drag) {
      spinV = (p.x - drag.x) * 0.01;
      pitchV = (p.y - drag.y) * 0.01;
      yaw += spinV;
      pitch = Math.max(-1.2, Math.min(1.2, pitch + pitchV));
      drag = p;
    }
    hover = p;
    if (still) draw();
  });
  const release = () => (drag = null);
  canvas.addEventListener("pointerup", release);
  canvas.addEventListener("pointercancel", release);
  canvas.addEventListener("pointerleave", () => {
    hover = null;
    if (still) draw();
  });

  // Reduced motion: no idle spin or inertia; the shape only moves while the visitor drags it.
  if (!still) {
    let visible = true;
    let running = false;
    let last = 0;
    const frame = (now: number) => {
      if (!visible) {
        running = false;
        return;
      }
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      t += dt;
      if (!drag) {
        yaw += spinV + dt * 0.25;
        pitch = Math.max(-1.2, Math.min(1.2, pitch + pitchV));
        spinV *= 0.94;
        pitchV *= 0.94;
      }
      // Lean slightly toward the hovered point.
      const tx = hover && !drag ? (hover.y / size - 0.5) * 0.5 : 0;
      const ty = hover && !drag ? (hover.x / size - 0.5) * 0.5 : 0;
      tiltX += (tx - tiltX) * 0.08;
      tiltY += (ty - tiltY) * 0.08;
      draw();
      requestAnimationFrame(frame);
    };
    // Only animate while it is on screen.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !running) {
        running = true;
        last = performance.now();
        requestAnimationFrame(frame);
      }
    }).observe(canvas);
  }
</script>
