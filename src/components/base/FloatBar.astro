---
import Tooltip from "../base/Tooltip.astro";
import IconSprite from "../base/IconSprite.astro";

const icons = [
  { title: "Sobre Mí", id: "meteor-icons:user", href: "#about" },
  { title: "Servicios", id: "ph:briefcase", href: "#services" },
  { title: "Proyectos", id: "lucide:folder", href: "#projects" },
  { title: "Contacto", id: "mdi:message-outline", href: "#contact" },
];

const dockBaseClasses = `
  fixed bottom-8 left-1/2 -translate-x-1/2 z-50
  flex justify-center items-center w-auto max-w-sm
  p-2 px-3 sm:bottom-12 sm:p-3
  rounded-3xl backdrop-blur-xl
  transition-all duration-500
  border border-transparent

  bg-indigo-950/90
  shadow-[5px_5px_15px_#292369]

  dark:bg-slate-950/60
  dark:border-white/10
  dark:shadow-[0_10px_30px_rgba(0,0,0,0.5)]
`;

const hiddenInitialClasses = `
  opacity-0 translate-y-4 pointer-events-none
`;

const iconButtonClasses = `
  flex w-9 h-9 p-2 
  rounded-full justify-center items-center cursor-pointer
  shadow-sm ring-1 
  transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)]

  text-indigo-800 bg-white ring-indigo-900
  dark:bg-slate-800 dark:text-indigo-300 dark:ring-slate-700
  
  hover:scale-110 hover:text-white 
  hover:shadow-xl hover:bg-gradient-to-br hover:from-indigo-500/90 hover:to-purple-600
  dark:hover:bg-indigo-600 dark:hover:text-white dark:hover:ring-indigo-500

  data-[active=true]:pointer-events-none 
  
  data-[active=true]:scale-125
  data-[active=true]:bg-indigo-600 
  data-[active=true]:text-white 
  data-[active=true]:ring-indigo-500
  
  dark:data-[active=true]:bg-indigo-500 
  dark:data-[active=true]:text-white 
  dark:data-[active=true]:ring-indigo-400
  dark:data-[active=true]:shadow-[0_0_20px_rgba(99,102,241,0.6)]
`;
---

<nav
  data-float-bar
  class={dockBaseClasses + " " + hiddenInitialClasses}
  aria-label="Navegación principal flotante"
>
  <ul
    class="flex justify-center items-center gap-4 rounded-3xl bg-transparent dark:bg-transparent"
  >
    {
      icons.map(({ href, id, title }) => (
        <li class="relative group">
          <a
            href={href}
            class={iconButtonClasses}
            aria-label={title}
            data-dock-link
          >
            <IconSprite id={id} class="w-5 h-5" />
          </a>
          <Tooltip text={title} classProp="whitespace-nowrap" />
        </li>
      ))
    }
  </ul>
</nav>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const dock = document.querySelector("[data-float-bar]");
    const mainNav = document.querySelector("[data-main-nav]");

    const toggleDock = (show) => {
      if (!dock) return;
      if (show) {
        dock.classList.remove(
          "opacity-0",
          "translate-y-4",
          "pointer-events-none"
        );
      } else {
        dock.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
      }
    };

    if (mainNav) {
      const navObserver = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          toggleDock(!entry.isIntersecting);
        },
        {
          root: null,
          threshold: 0,
        }
      );

      navObserver.observe(mainNav);
    } else {
      setTimeout(() => toggleDock(true), 500);
    }

    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("[data-dock-link]");

    const spyObserverOptions = {
      root: null,
      rootMargin: "-20% 0px -20% 0px",
      threshold: 0.2,
    };

    const spyObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const activeId = entry.target.getAttribute("id");

          navLinks.forEach((link) => {
            link.setAttribute("data-active", "false");
            const linkHref = link.getAttribute("href");
            if (linkHref === `#${activeId}`) {
              link.setAttribute("data-active", "true");
            }
          });
        }
      });
    }, spyObserverOptions);

    sections.forEach((section) => {
      spyObserver.observe(section);
    });
  });
</script>
