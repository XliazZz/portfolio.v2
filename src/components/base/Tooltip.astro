---
interface Props {
  text?: string;
  classProp?: string;
}

const { text, classProp } = Astro.props;

const baseClasses = `
  absolute bottom-[140%] left-1/2 -translate-x-1/2
  px-3 py-1.5 text-xs font-body text-white
  bg-gray-900/95 rounded-md shadow-md backdrop-blur-md
  opacity-0 translate-y-3 pointer-events-none
  z-20 leading-snug whitespace-nowrap
  transition-all duration-300 ease-out
  group-hover:opacity-100 group-hover:translate-y-0
  group-focus-within:opacity-100 group-focus-within:translate-y-0
`;

const finalClass = classProp ? `${baseClasses} ${classProp}` : baseClasses;
---

<span
  class={finalClass}
  role="tooltip"
  aria-hidden={text ? "false" : "true"}
>
  {text}
</span>
