---
// Downloads the CV in the active language: Layout's i18n script swaps href through data-en-href.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/cv/Elias_Martinez_CV_ES.pdf"
  data-en-href="/cv/Elias_Martinez_CV_EN.pdf"
  download
  class={className}><slot /></a
>
