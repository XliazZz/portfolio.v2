---
// Material Symbols glyph. Size goes inline because Google's unlayered font CSS beats Tailwind's layered utilities.
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<span
  class:list={["material-symbols-outlined select-none", className]}
  style={`font-size:${size}px`}
  aria-hidden="true">{name}</span
>
