---
// Material Symbols glyph from the self-hosted subset in global.css (new names need a re-downloaded font).
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<span
  class:list={["material-symbols-outlined select-none", className]}
  style={`font-size:${size}px`}
  aria-hidden="true">{name}</span
>
