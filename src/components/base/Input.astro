---
const {
  type = "text",
  id,
  name,
  autoComplete = "",
  placeholder = "",
  value,
  disabled = false,
  required = false,
} = Astro.props;
---

<input
  type={type}
  name={name}
  id={id}
  autocomplete={autoComplete}
  required={required}
  placeholder={placeholder}
  value={value}
  disabled={disabled}
  class="block
      w-full
      px-4 py-3
      text-gray-900 font-body
      bg-gray-50 text-xs
      rounded-lg border-0
      shadow-sm shadow-indigo-700
      ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 transition duration-200 hover:bg-white
      sm:text-sm sm:leading-6
      md:text-base"
/>
