---
import Icon from "./Icon.astro";
import CvLink from "./CvLink.astro";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const sections = [
  { id: "about", name: "SOBRE MÍ", nameEn: "ABOUT" },
  { id: "stack", name: "STACK", nameEn: "STACK" },
  { id: "experience", name: "EXPERIENCIA", nameEn: "EXPERIENCE" },
  { id: "projects", name: "PROYECTOS", nameEn: "PROJECTS" },
  { id: "contact", name: "CONTACTO", nameEn: "CONTACT" },
];

const langButton =
  "rounded-sm px-1.5 py-0.5 font-mono text-label-sm text-on-surface-variant transition-colors hover:text-on-surface aria-[current=page]:bg-surface-container aria-[current=page]:font-semibold aria-[current=page]:text-tertiary";
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-5"
>
  <div
    class="pointer-events-auto mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-2 rounded-xl border border-outline-variant/30 bg-surface-container-lowest/80 px-3 shadow-[0_8px_32px_rgba(0,0,0,0.5)] backdrop-blur-xl md:px-4"
  >
    <a
      href="#hero"
      class="flex shrink-0 items-center gap-2.5"
      aria-label="Elías Martínez, ir al inicio"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md border border-tertiary/50 bg-surface-container font-display text-label-lg font-bold text-tertiary shadow-[0_0_16px_rgba(39,218,240,0.25)]"
        aria-hidden="true">EM</span
      >
      <span class="flex flex-col">
        <span
          class="font-display text-label-lg font-bold tracking-tight text-on-surface"
          >ELÍAS // MARTÍNEZ</span
        >
        <span class="font-mono text-label-sm tracking-widest text-tertiary"
          >FULL STACK / SYS.ONLINE</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Secciones">
      {
        sections.map((s, i) => (
          <a
            href={`#${s.id}`}
            data-nav-link
            class="rounded-md px-2 py-1 font-mono text-label-sm whitespace-nowrap text-on-surface-variant transition-colors hover:text-on-surface aria-[current=true]:bg-surface-container-high aria-[current=true]:font-bold aria-[current=true]:text-tertiary"
          >
            <span class="mr-1 hidden xl:inline" aria-hidden="true">
              // 0{i + 1}.
            </span>
            <span data-en={s.nameEn}>{s.name}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <div
        class="flex items-center rounded-md bg-surface-container-high/60 p-1"
        role="group"
        aria-label="Idioma / Language"
      >
        <a
          href="/"
          hreflang="es"
          data-lang="es"
          aria-current={lang === "es" ? "page" : undefined}
          class={langButton}>ES</a
        >
        <span
          class="px-0.5 font-mono text-label-sm text-outline"
          aria-hidden="true">/</span
        >
        <a
          href="/en/"
          hreflang="en"
          data-lang="en"
          aria-current={lang === "en" ? "page" : undefined}
          class={langButton}>EN</a
        >
      </div>

      <CvLink
        class="hidden items-center gap-1.5 rounded-md bg-tertiary px-4 py-2 font-mono text-label-sm font-semibold tracking-wider text-on-tertiary shadow-[0_0_20px_rgba(39,218,240,0.35)] transition-colors hover:bg-tertiary-fixed md:inline-flex"
      >
        <Icon name="download" size={16} />
        <span class="sr-only" data-en="Download">Descargar</span> CV
      </CvLink>

      <button
        type="button"
        id="menu-btn"
        class="flex h-8 w-8 items-center justify-center rounded-md bg-surface-container-high text-on-surface lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    hidden
    aria-label="Secciones"
    class="pointer-events-auto mx-auto mt-2 flex max-w-6xl flex-col rounded-xl border border-outline-variant/30 bg-surface-container-lowest/95 p-2 backdrop-blur-xl lg:hidden"
  >
    {
      sections.map((s, i) => (
        <a
          href={`#${s.id}`}
          class="rounded-md px-3 py-3 font-mono text-label-md text-on-surface-variant transition-colors hover:bg-surface-container hover:text-tertiary"
        >
          <span class="text-tertiary" aria-hidden="true">
            // 0{i + 1}.
          </span>{" "}
          <span data-en={s.nameEn}>{s.name}</span>
        </a>
      ))
    }
    <CvLink
      class="mt-1 flex items-center gap-2 rounded-md bg-tertiary px-3 py-3 font-mono text-label-md font-semibold text-on-tertiary md:hidden"
    >
      <Icon name="download" size={16} />
      <span class="sr-only" data-en="Download">Descargar</span> CV
    </CvLink>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
  };
  menuBtn.addEventListener("click", () => setMenu(menu.hidden === true));
  menu
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setMenu(false)));

  // An explicit language choice beats browser detection on the next visit (see Layout).
  document.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("lang", a.dataset.lang!);
      } catch {}
    }),
  );

  // Highlight the nav link of the section crossing the middle of the viewport.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) =>
          link.setAttribute(
            "aria-current",
            String(link.hash === `#${entry.target.id}`),
          ),
        );
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  // The hero has no link: observing it clears the highlight when scrolling back to the top.
  ["#hero", ...Array.from(links, (link) => link.hash)].forEach((hash) => {
    const section = document.querySelector(hash);
    if (section) observer.observe(section);
  });
</script>
