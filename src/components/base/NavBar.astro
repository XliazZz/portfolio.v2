---
import Button from "./Button.astro";

const sections = [
  { name: "Sobre mí", href: "#about" },
  { name: "Proyectos", href: "#projects" },
  { name: "Servicios", href: "#services" },
];

const contactUrl =
  "https://wa.me/5491135726318?text=Hola!%20Quiero%20info%20sobre%20mi%20página%20web";
---

<div
  class="z-50 w-full bg-white dark:bg-slate-950/90 border-b border-slate-100 dark:border-slate-800 top-0 lg:relative"
  data-main-nav
>
  <nav
    class="max-w-4xl mx-auto px-3 py-4
      md:py-6
      lg:z-10 lg:h-full lg:py-3 lg:border-none lg:sticky lg:top-0 lg:left-0 lg:right-0 lg:max-w-5xl lg:px-5
      xl:max-w-6xl xl:px-0
      2xl:max-w-7xl"
  >
    <div class="flex justify-between
        lg:items-center">
      <a
        href="/"
        class="flex space-x-2 items-center"
        aria-label="Ir a la página de inicio, Code & Design"
      >
        <span
          class="text-transparent font-heading font-semibold text-xl
            bg-gradient-to-r from-indigo-500 via-purple-700 to-indigo-500 bg-clip-text
            sm:text-2xl
            lg:text-2xl
            md:text-3xl"
        >
          Code & Design
        </span>
      </a>

      <div class="hidden lg:flex lg:space-x-8 lg:items-center">
        <ul
          class="flex space-x-11 text-base font-normal text-indigo-950/80
            lg:text-[15px] lg:space-x-8
            xl:text-lg xl:space-x-10
            dark:text-slate-100"
        >
          {
            sections.map((section) => (
              <li class="font-heading relative">
                <a
                  href={section.href}
                  class="pb-2.5 border-b-2 border-transparent transition-colors duration-300
                    hover:border-indigo-500 hover:text-indigo-500
                    dark:hover:border-indigo-400 dark:hover:text-indigo-300
                    lg:text-base"
                >
                  {section.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="hidden
      gap-x-2
      lg:flex lg:items-center">
          <Button
            href={contactUrl}
            icon="contactIcon"
            iconClass="xl:w-7 xl:h-7"
            class="px-6 py-2.5 lg:text-lg text-base rounded-xl font-semibold hover:shadow-lg xl:px-5 xl:text-lg"
            variant="attention"
            openInNewTab={true}
            ariaLabel="Contactar por WhatsApp para hablar sobre tu página web"
          >
            Contacto
          </Button>
        </div>
      </div>
    </div>
  </nav>
</div>
