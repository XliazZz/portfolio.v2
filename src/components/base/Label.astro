---
interface Props {
  for: string;
  text: string;
}

const { for: forId, text } = Astro.props;
---

<label
  for={forId}
  class="block
      mb-2
      text-sm font-semibold leading-6 text-indigo-900 dark:text-indigo-400 font-heading
      md:text-base
      lg:text-sm
      xl:text-base"
>
  {text}
</label>
