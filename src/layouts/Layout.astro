---
import "../styles/global.css";
import ShaderBackground from "../components/base/ShaderBackground.astro";
import inter from "../assets/fonts/inter.woff2?url";
import spaceGrotesk from "../assets/fonts/space-grotesk.woff2?url";
import jetbrainsMono from "../assets/fonts/jetbrains-mono.woff2?url";
interface Props {
  lang?: "es" | "en";
  noindex?: boolean;
  title: string;
  description: string;
  image?: string;

  authorName: string;
  authorUrl: string;
  socialProfiles: {
    linkedin: string;
    github: string;
  };
}

const {
  lang = "es",
  noindex = false,
  title,
  description,
  image,
  authorName,
  authorUrl,
  socialProfiles,
} = Astro.props;

// The home is the only indexable page, in both languages.
const alternates = {
  es: new URL("/", Astro.site).href,
  en: new URL("/en/", Astro.site).href,
};
const canonical = alternates[lang];

const personId = `${authorUrl.replace(/\/$/, "")}#person`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: authorName,
  url: authorUrl,
  jobTitle: "Software Engineer · Full Stack",
  email: "mailto:eliasdev1912@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Buenos Aires",
    addressCountry: "AR",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad de Buenos Aires",
  },
  knowsLanguage: ["es", "pt", "en"],
  knowsAbout: [
    "TypeScript",
    "React",
    "Astro",
    "Next.js",
    "Node.js",
    "Python",
    "PostgreSQL",
    "MongoDB",
  ],
  sameAs: [socialProfiles.linkedin, socialProfiles.github],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: title,
  url: canonical,
  description,
  inLanguage: lang === "en" ? "en" : "es-AR",
  author: {
    "@id": personId,
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Runs before anything renders: a first visit to / from a non-Spanish browser (or after picking EN) goes to /en/.
         Crawlers stay put so each URL is indexed in its own language. -->
    <script is:inline>
      if (location.pathname === "/") {
        let saved = null;
        try {
          saved = localStorage.getItem("lang");
        } catch {}
        const browser = (
          navigator.languages?.[0] ??
          navigator.language ??
          "es"
        ).toLowerCase();
        const bot = /bot|crawl|spider/i.test(navigator.userAgent);
        if ((saved ?? (bot || browser.startsWith("es") ? "es" : "en")) === "en")
          location.replace("/en/" + location.hash);
      }
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Elias Dev" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex" : "index,follow"} />
    <meta name="author" content="Elías Martínez" />
    <meta
      property="og:site_name"
      content="Elías Martínez · Software Engineer"
    />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_AR" : "en_US"}
    />

    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {
      image && (
        <>
          <meta property="og:image" content={image} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- All three fonts render in the first viewport; preloading skips waiting for the CSS to discover them -->
    {
      [inter, spaceGrotesk, jetbrainsMono].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es" href={alternates.es} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.es} />
        </>
      )
    }

    <meta name="theme-color" content="#131317" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify([personSchema, websiteSchema])}
    />
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-background font-sans text-body-md text-on-surface antialiased selection:bg-tertiary-container selection:text-on-tertiary-container"
  >
    <a
      href="#main-content"
      class="sr-only z-[60] rounded-md bg-tertiary px-4 py-2 font-mono text-label-md text-on-tertiary focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
      data-en="Skip to content">Saltar al contenido</a
    >

    <ShaderBackground />

    <slot />
  </body>
</html>
