---
import "../styles/global.css";
import ShaderBackground from "../components/base/ShaderBackground.astro";
import inter from "../assets/fonts/inter.woff2?url";
import spaceGrotesk from "../assets/fonts/space-grotesk.woff2?url";
import jetbrainsMono from "../assets/fonts/jetbrains-mono.woff2?url";
interface Props {
  title: string;
  description: string;
  image?: string;

  authorName: string;
  authorUrl: string;
  socialProfiles: {
    linkedin: string;
    github: string;
  };
}

const { title, description, image, authorName, authorUrl, socialProfiles } =
  Astro.props;

const personId = `${authorUrl.replace(/\/$/, "")}#person`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: authorName,
  url: authorUrl,
  jobTitle: "Software Engineer · Full Stack",
  email: "mailto:eliasdev1912@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Buenos Aires",
    addressCountry: "AR",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad de Buenos Aires",
  },
  knowsLanguage: ["es", "pt", "en"],
  sameAs: [socialProfiles.linkedin, socialProfiles.github],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: title,
  url: Astro.url.href,
  description,
  inLanguage: "es-AR",
  author: {
    "@id": personId,
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Elias Dev" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="Elías Martínez" />
    <meta
      property="og:site_name"
      content="Elías Martínez · Software Engineer"
    />
    <meta property="og:locale" content="es_AR" />

    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {image && <meta property="og:image" content={image} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- All three fonts render in the first viewport; preloading skips waiting for the CSS to discover them -->
    {
      [inter, spaceGrotesk, jetbrainsMono].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }

    <link rel="canonical" href={Astro.url.href} />

    <meta name="theme-color" content="#131317" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify([personSchema, websiteSchema])}
    />
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-background font-sans text-body-md text-on-surface antialiased selection:bg-tertiary-container selection:text-on-tertiary-container"
  >
    <a
      href="#main-content"
      class="sr-only z-[60] rounded-md bg-tertiary px-4 py-2 font-mono text-label-md text-on-tertiary focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
      data-en="Skip to content">Saltar al contenido</a
    >

    <ShaderBackground />

    <slot />

    <!-- Inline (not bundled) so it runs while the page is parsed, before first paint: no flash of Spanish for EN visitors. -->
    <script is:inline>
      // ES is server-rendered; [data-en] holds the English text and the Spanish one is cached on first swap.
      // shortcut: English exists only client-side, so search engines and link previews see Spanish; add /en routes if that matters.
      const apply = (lang) => {
        document.documentElement.lang = lang;
        document.querySelectorAll("[data-en]").forEach((el) => {
          el.dataset.es ??= el.textContent ?? "";
          el.textContent = lang === "en" ? el.dataset.en : el.dataset.es;
        });
        // Same idea for attributes, e.g. data-en-href on the CV link so it downloads the current language.
        for (const attr of ["href", "placeholder"]) {
          document.querySelectorAll(`[data-en-${attr}]`).forEach((el) => {
            if (!el.hasAttribute(`data-es-${attr}`))
              el.setAttribute(`data-es-${attr}`, el.getAttribute(attr) ?? "");
            el.setAttribute(attr, el.getAttribute(`data-${lang}-${attr}`));
          });
        }
        document
          .querySelectorAll("[data-lang]")
          .forEach((b) =>
            b.setAttribute("aria-pressed", String(b.dataset.lang === lang)),
          );
      };

      document.querySelectorAll("[data-lang]").forEach((b) =>
        b.addEventListener("click", () => {
          apply(b.dataset.lang);
          try {
            localStorage.setItem("lang", b.dataset.lang);
          } catch {}
        }),
      );

      // An explicit choice wins; otherwise Spanish only for browsers that prefer it, English for everyone else.
      let saved = null;
      try {
        saved = localStorage.getItem("lang");
      } catch {}
      const browser = (
        navigator.languages?.[0] ??
        navigator.language ??
        "es"
      ).toLowerCase();
      if ((saved ?? (browser.startsWith("es") ? "es" : "en")) === "en")
        apply("en");
    </script>
  </body>
</html>
